# Bazar Baz environment template
# Copy to .env locally. Never commit real .env files or production secrets.

# Core app
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEPLOYED_APP_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Comma-separated platform hosts that should NOT be treated as tenant custom domains.
BAZAR_BAZ_PLATFORM_HOSTS=bazar-baz.ir,www.bazar-baz.ir,shadcn-rtl.vercel.app,localhost,127.0.0.1,bazarbaaz.ir,www.bazarbaaz.ir
# Shared secret used by proxy.ts to call the internal custom-domain resolver. Required in production for custom domains.
CUSTOM_DOMAIN_RESOLVER_SECRET=replace-with-a-strong-random-secret

# Vercel custom-domain automation
# Required only when SUPER_ADMIN should add/check/remove shop domains from the dashboard.
VERCEL_API_TOKEN=
# Deprecated fallback name kept for older deployments; prefer VERCEL_API_TOKEN.
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Optional alternative to VERCEL_TEAM_ID when using team slug.
VERCEL_TEAM_SLUG=
# Set true in staging/local to validate flows without mutating Vercel.
VERCEL_DOMAIN_AUTOMATION_DRY_RUN=true

# Custom domain provider safety
CUSTOM_DOMAIN_PROVIDER=
CUSTOM_DOMAIN_PROVIDER_ENABLED=false
CUSTOM_DOMAIN_REAL_MUTATION_ENABLED=false
CUSTOM_DOMAIN_REAL_MUTATION_ACK=
# Comma-separated platform hosts that should NOT be treated as tenant custom domains.
CUSTOM_DOMAIN_PLATFORM_HOSTS=
CUSTOM_DOMAIN_DEFAULT_LOCALE=fa

# Database
DATABASE_URL=
# Direct/non-pooled URL for Prisma CLI, migrations, introspection, and administrative schema operations.
DIRECT_URL=
# Legacy direct/non-pooled compatibility alias for older ops scripts. Prefer DIRECT_URL.
DATABASE_URL_UNPOOLED=

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob Storage (Required for image uploads)
# Get your token from https://vercel.com/dashboard/blob
BLOB_READ_WRITE_TOKEN=

# PWA
PWA_ENABLED=true

# Web Push / VAPID
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_PROVIDER=dry_run
WEB_PUSH_DRY_RUN=true
WEB_PUSH_REAL_SEND_ENABLED=false

# SMS provider
# Keep dry-run enabled for local/dev/test/CI/deployed smoke tests.
# Real SMS must only be enabled explicitly in production secret storage.
SMS_PROVIDER=DRY_RUN
SMS_DRY_RUN=true
SMS_REAL_SEND_ENABLED=false
DEPLOYED_ALLOW_REAL_SMS=0
DEPLOYED_SMS_TARGET_MOBILE=
SMS_REAL_SEND_OPERATOR_CONFIRMED=0
SMS_IR_USERNAME=
SMS_IR_API_KEY=
SMS_IR_LINE=
SMS_IR_LINE_NUMBER=
SMS_IR_BASE_URL=https://api.sms.ir/v1
SMS_IR_TIMEOUT_MS=15000
SMS_IR_SEND_MODE=URL
SMS_IR_VERIFY_TEMPLATE_ID=
SMS_IR_ALLOW_REAL_SEND_ACK=
SMS_IR_ALLOWED_TEST_RECIPIENTS=
SMS_GUEST_REAL_SEND_ENABLED=false
SMS_GUEST_ALLOW_REAL_SEND_ACK=

# Realtime / Socket.IO signaling
# Optional. Leave empty to disable Socket.IO in production.
# If set, must be a public HTTPS/WSS URL. Never use localhost or private IPs in production.
NEXT_PUBLIC_SIGNALING_SERVER_URL=

# AI Media Service (MOCK mode)
# Set AI_MEDIA_SERVICE_ENABLED=true to enable the AI image suggestion feature.
# The service runs in MOCK mode on Render and does not call any paid provider.
AI_MEDIA_SERVICE_ENABLED=false
AI_MEDIA_SERVICE_URL=https://bazar-baz-ai-media-service.onrender.com
AI_MEDIA_SERVICE_INTERNAL_KEY=
AI_MEDIA_SERVICE_TIMEOUT_MS=60000

# Creative Studio organization brand provider rollout gate
# Keep disabled until the provider contract, approval, and rollback controls are explicitly configured.
CREATIVE_STUDIO_ORGANIZATION_BRAND_PROVIDER_ENABLED=false
CREATIVE_STUDIO_ORGANIZATION_BRAND_PROVIDER_EXECUTION_ENABLED=false
CREATIVE_STUDIO_ORGANIZATION_BRAND_PROVIDER_DRY_RUN=true
CREATIVE_STUDIO_ORGANIZATION_BRAND_PROVIDER_RESULTS_ENABLED=false
CREATIVE_STUDIO_ORGANIZATION_BRAND_PROVIDER_RESULT_DRY_RUN=true
CREATIVE_STUDIO_ORGANIZATION_BRAND_PROVIDER_POLLING_ENABLED=false
CREATIVE_STUDIO_ORGANIZATION_BRAND_SERVICE_URL=
CREATIVE_STUDIO_ORGANIZATION_BRAND_INTERNAL_KEY=
CREATIVE_STUDIO_PROVIDER_RESULTS_INTERNAL_KEY=
CREATIVE_STUDIO_ORGANIZATION_BRAND_PROVIDER_APPROVED=false
CREATIVE_STUDIO_ORGANIZATION_BRAND_PROVIDER_APPROVED_BY=
CREATIVE_STUDIO_ORGANIZATION_BRAND_PROVIDER_APPROVED_AT=
CREATIVE_STUDIO_ORGANIZATION_BRAND_DAILY_JOB_LIMIT=
CREATIVE_STUDIO_ORGANIZATION_BRAND_ESTIMATED_JOB_COST_CENTS=
CREATIVE_STUDIO_ORGANIZATION_BRAND_ROLLBACK_PAUSED=false
CREATIVE_STUDIO_ORGANIZATION_BRAND_ROLLBACK_REASON=
CREATIVE_STUDIO_ORGANIZATION_BRAND_ROLLBACK_BY=
CREATIVE_STUDIO_ORGANIZATION_BRAND_ROLLBACK_AT=

# Optional alias used by the server-only AI Media Service client. AI_MEDIA_SERVICE_URL remains supported.
AI_MEDIA_SERVICE_BASE_URL=
# BB-AI-MEDIA-P02-P03 uses the live product-image contract only.
# Organization logo/cover Render execution remains unavailable until a compatible live operation is proven.
AI_MEDIA_CONTRACT_FINGERPRINT=ab70c8d0bb1d9ccd
