  @@unique([organizationId, recommendationType, title])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, recommendationType])
  @@index([organizationId, priority])
  @@index([profileId])
  @@index([keywordClusterId])
  @@index([seoOpportunityId])
  @@index([businessEntityId])
