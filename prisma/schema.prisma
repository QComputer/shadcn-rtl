  hotelWebsiteOperations                HotelWebsiteOperation[]       @relation("HotelWebsiteOperationActor")
  aiMediaUsageQuotes            AiMediaUsageQuote[]           @relation("AiMediaQuoteRequestedBy")
  aiMediaSpendHolds             AiMediaSpendHold[]            @relation("AiMediaSpendHoldRequestedBy")
  ussdSessions                  UssdSession[]                 @relation("UssdSessionCustomer")
  updatedInotiPaymentRoutings   OrganizationInotiPaymentRouting[] @relation("InotiPaymentRoutingUpdatedBy")
  customerIdentities            CustomerIdentity[]            @relation("CustomerIdentityUser")

  denies                          Deny[]
  orderMessages                   OrderMessage[]
  reviewedLeads                   RequestDemoLead[]        @relation("LeadReviewerRelation")
  createdTenantProvisioningPlans  TenantProvisioningPlan[] @relation("TenantProvisioningPlanCreatedBy")
  updatedTenantProvisioningPlans  TenantProvisioningPlan[] @relation("TenantProvisioningPlanUpdatedBy")
  approvedTenantProvisioningPlans TenantProvisioningPlan[] @relation("TenantProvisioningPlanApprovedBy")
  createdOrganizationAcquisitions OrganizationAcquisition[] @relation("OrganizationAcquisitionCreatedBy")
  agentOrganizationAcquisitions   OrganizationAcquisition[] @relation("OrganizationAcquisitionAgent")
  createdOrganizationInvitations  OrganizationInvitation[]  @relation("OrganizationInvitationCreatedBy")
  claimedOrganizationInvitations  OrganizationInvitation[]  @relation("OrganizationInvitationClaimedBy")
  receivedOrganizationInvitations OrganizationInvitation[]  @relation("OrganizationInvitationRecipient")
  organizationClaimRequests       OrganizationClaimRequest[] @relation("OrganizationClaimRequester")
  reviewedOrganizationClaims      OrganizationClaimRequest[] @relation("OrganizationClaimReviewedBy")

  @@index([email])
  @@index([name])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@index([emailVerified])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole @default(STAFF)
  isActive       Boolean  @default(true)
  joinedAt       DateTime @default(now())

  organizationSlug String

  organization Organization @relation(fields: [organizationId, organizationSlug], references: [id, slug])

  user         User                @relation(fields: [userId], references: [id])
  availability StaffAvailability[]

  @@unique([organizationId, userId])
  //@@index([organizationSlug, userId])
  @@index([organizationSlug])
  @@index([organizationId])
  @@index([userId])
}

model BusinessHour {
  id        String    @id @default(cuid())
  day       DayOfWeek
  openTime  String // Format "HH:mm"
  closeTime String // Format "HH:mm"
  isOpen    Boolean   @default(true)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, day, userId])
  @@index([organizationId])
}

// --- AUTHENTICATION MODELS ---
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String    @unique
  token      String    @unique
  email      String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

// --- APPOINTMENT MODELS ---
model ServiceCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String?
  description String? //@db.Text
  image       String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  services Service[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([organizationId, slug])
  @@index([deletedAt])
}

model Service {
  id                    String  @id @default(cuid())
  name                  String
  slug                  String?
  description           String? //@db.Text
  price                 Decimal //@db.Decimal(12, 2)
  duration              Int // In minutes
  image                 String?
  aiPrimaryMediaAssetId String?
  isActive              Boolean @default(true)
  sortOrder             Int     @default(0)

  organizationId    String
  categoryId        String
  serviceProviderId String?

  organization        Organization    @relation(fields: [organizationId], references: [id])
  category            ServiceCategory @relation(fields: [categoryId], references: [id])
  serviceProvider     User?           @relation("ServiceProviderRelation", fields: [serviceProviderId], references: [id])
  aiPrimaryMediaAsset AiMediaAsset?   @relation("ServiceAiPrimaryMediaAsset", fields: [aiPrimaryMediaAssetId], references: [id], onDelete: SetNull)
  appointments        Appointment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([organizationId, slug])
  @@index([categoryId])
  @@index([serviceProviderId])
  @@index([aiPrimaryMediaAssetId])
  @@index([deletedAt])
}

model Appointment {
  id        String            @id @default(cuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(PENDING)
  notes     String? //@db.Text

  timeInterval   TimeInterval? @relation(fields: [timeIntervalid], references: [id])
  timeIntervalid String?

  // Cancellation details
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledBy        String?

  // Confirmation details
  confirmedAt DateTime?
  confirmedBy String?

  // Reminder tracking
  reminderSentAt DateTime?
  reminderSentBy String?
  followUpSentAt DateTime?
  followUpSentBy String?

  // Customer contact info at booking time (for guests)
  customerNameAtBooking  String?
  customerPhoneAtBooking String?
  customerEmailAtBooking String?

  // Booking reference for guest lookup
  bookingReference String? @unique

  customerId      String?
  customer        User?          @relation("CustomerAppointmentRelation", fields: [customerId], references: [id])
  guestCustomerId String?
  guestCustomer   GuestCustomer? @relation(fields: [guestCustomerId], references: [id])
  paymentRequests PaymentRequest[]

  serviceId String

  service Service @relation(fields: [serviceId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([guestCustomerId])
  @@index([serviceId])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
  @@index([bookingReference])
}

// Staff availability for service providers
model StaffAvailability {
  id          String    @id @default(cuid())
  dayOfWeek   DayOfWeek
  startTime   String // Format "HH:mm"
  endTime     String // Format "HH:mm"
  isAvailable Boolean   @default(true)
  breakStart  String? // Format "HH:mm"
  breakEnd    String? // Format "HH:mm"

  // Specific date override (for vacations, special hours, etc.)
  specificDate DateTime?
  isDayOff     Boolean   @default(false)

  organizationId String
  staffId        String

  organization Organization       @relation(fields: [organizationId], references: [id])
  staff        OrganizationMember @relation(fields: [staffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, dayOfWeek, specificDate])
  @@index([organizationId])
  @@index([staffId])
  @@index([specificDate])
}

// Booking session for tracking booking attempts and analytics
model BookingSession {
  id             String    @id @default(cuid())
  sessionId      String    @unique
  organizationId String
  serviceId      String?
  selectedDate   DateTime?
  selectedTime   String?
  customerName   String?
  customerPhone  String?
  customerEmail  String?
  status         String    @default("started") // started, service_selected, datetime_selected, completed, abandoned
  completedAt    DateTime?
  abandonedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([organizationId])
  @@index([sessionId])
  @@index([status])
  @@index([expiresAt])
}

// --- SHOP MODELS ---

model ProductCategory {
  id               String  @id @default(cuid())
  name             String
  slug             String?
  description      String? //@db.Text
  image            String?
  sortOrder        Int     @default(0)
  isActive         Boolean @default(true)
  organizationId   String
  organizationSlug String

  organization Organization @relation(fields: [organizationId, organizationSlug], references: [id, slug])
  products     Product[]
  categoryAssignments ProductCategoryAssignment[] @relation("AssignedCategoryProducts")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([organizationSlug])
  @@index([organizationId, slug])
  @@unique([id, organizationId])
  @@index([deletedAt])
}

model Image {
  id        String      @id @default(cuid())
  url       String
  filename  String?
  mimeType  String?
  sizeBytes Int?
  purpose   String      @default("upload")
  access    ImageAccess @default(PUBLIC)

  uploadedByUserId String?
  organizationId   String?

  createdAt DateTime @default(now())

  uploadedBy   User?         @relation("UploadedImages", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation("OrganizationImages", fields: [organizationId], references: [id], onDelete: SetNull)
  products     Product[]
  hotelWebsiteMedia HotelWebsiteMediaAssociation[]
  variantGalleryEntries ProductVariantImage[]

  @@unique([id, organizationId])
  @@index([uploadedByUserId])
  @@index([organizationId])
  @@index([purpose])
  @@index([access])
  @@index([createdAt])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  brand       String?
  slug        String?
  description String? //@db.Text
  basePrice   Decimal //@db.Decimal(12, 2)

  image                 String?
  images                Image[]
  aiPrimaryMediaAssetId String?
  sku                   String?
  isActive              Boolean @default(true)
  sortOrder             Int     @default(0)
  preparationMinutes    Int?

  // Inventory management

  trackInventory    Boolean @default(true)
  lowStockThreshold Int     @default(10)

  // Pricing / discount

  discountType  String?  @default("none") // "none" | "percentage" | "fixed"
  discountValue Decimal? @default(0) //@db.Decimal(12, 2)

  organizationId   String
  organizationSlug String
  categoryId       String

  organization        Organization     @relation(fields: [organizationId, organizationSlug], references: [id, slug])
  category            ProductCategory  @relation(fields: [categoryId], references: [id])
  aiPrimaryMediaAsset AiMediaAsset?    @relation("ProductAiPrimaryMediaAsset", fields: [aiPrimaryMediaAssetId], references: [id], onDelete: SetNull)
  variants            ProductVariant[]
  attributeValues     ProductAttributeValue[]
  categoryAssignments ProductCategoryAssignment[] @relation("ProductCategories")
  tagAssignments      ProductTagAssignment[] @relation("ProductTags")
  orderItems          OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@unique([id, organizationId])
  @@index([organizationSlug])
  @@index([organizationId, slug])
  @@index([organizationSlug, slug])
  @@index([categoryId])
  @@index([aiPrimaryMediaAssetId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([sku])
}

model ProductCategoryAssignment {
  productId      String
  categoryId     String
  organizationId String
  createdAt      DateTime @default(now())

  product  Product         @relation("ProductCategories", fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  category ProductCategory @relation("AssignedCategoryProducts", fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([organizationId, categoryId])
  @@index([categoryId])
}

model ProductTag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  ProductTagAssignment[]

  @@unique([organizationId, normalizedName])
  @@unique([id, organizationId])
  @@index([organizationId])
}

model ProductTagAssignment {
  productId      String
  tagId          String
  organizationId String
  createdAt      DateTime @default(now())

  product Product    @relation("ProductTags", fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  tag     ProductTag @relation(fields: [tagId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([organizationId, tagId])
  @@index([tagId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  sku       String?  @unique
  name      String? // e.g., "Large / Red"
  image     String?
  price     Decimal? //@db.Decimal(12, 2) // Override basePrice if set
  inventory Int      @default(0)

  // Stock management
  reservedQuantity Int     @default(0)
  allowBackOrder   Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItems          ShopCartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  optionValues       ProductVariantAttributeValue[]
  galleryImages      ProductVariantImage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId])
  @@index([deletedAt])
}

model ProductVariantImage {
  variantId String
  imageId   String
  sortOrder Int @default(0)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  image   Image          @relation(fields: [imageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([variantId, imageId])
  @@unique([variantId, sortOrder])
  @@index([imageId])
}

// Tenant-configured retail attributes. PRODUCT definitions describe/filter the
// product; VARIANT_OPTION definitions are assigned only to explicitly created
// purchasable variants. No option combination generation is implied.
model RetailAttributeDefinition {
  id                String                    @id @default(cuid())
  organizationId    String
  key               String
  label             String
  localizedLabels   Json                      @default("{}")
  scope             RetailAttributeScope
  valueType         RetailAttributeValueType
  displayUnit       String?
  localizedUnits    Json                      @default("{}")
  allowedValues     Json?
  isFilterable      Boolean                   @default(false)
  sortOrder         Int                       @default(0)
  isActive          Boolean                   @default(true)
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productValues     ProductAttributeValue[]
  variantValues     ProductVariantAttributeValue[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([organizationId, key])
  @@unique([id, organizationId])
  @@index([organizationId, scope, isActive, sortOrder])
}

model ProductAttributeValue {
  id             String                   @id @default(cuid())
  productId      String
  definitionId   String
  valueText      String?
  valueNumber    Decimal?                  @db.Decimal(18, 4)
  valueBoolean   Boolean?
  product        Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition     RetailAttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([productId, definitionId])
  @@index([definitionId, valueText])
  @@index([definitionId, valueNumber])
  @@index([definitionId, valueBoolean])
}

model ProductVariantAttributeValue {
  id             String                   @id @default(cuid())
  variantId      String
  definitionId   String
  valueText      String?
  valueNumber    Decimal?                  @db.Decimal(18, 4)
  valueBoolean   Boolean?
  variant        ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  definition     RetailAttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([variantId, definitionId])
  @@index([definitionId, valueText])
  @@index([definitionId, valueNumber])
  @@index([definitionId, valueBoolean])
}

model ShopCart {
  id     String     @id @default(cuid())
  status CartStatus @default(ACTIVE)

  organizationSlug String
  organization     Organization @relation(fields: [organizationSlug], references: [slug])

  customerId String?
  customer   User?   @relation(fields: [customerId], references: [id])

  sessionId String?

  expiresAt DateTime? // Cart expiration (e.g., 7 days)

  items ShopCartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationSlug, customerId])
  @@unique([organizationSlug, sessionId])
  @@index([status])
  @@index([customerId])
  @@index([organizationSlug, customerId])
  @@index([sessionId])
  @@index([organizationSlug, sessionId])
}

model ShopCartItem {
  id       String @id @default(cuid())
  quantity Int

  cartId    String
  variantId String

  cart    ShopCart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([variantId])
}

// Guest Customer
model GuestCustomer {
  id        String  @id @default(cuid())
  name      String
  firstName String?
  lastName  String?
  sessionId String  @unique
  phone     String?
  email     String?
  address   String?

  appointments Appointment[]
  orders       Order[]
  ussdSessions UssdSession[]
  customerIdentities CustomerIdentity[]
  paymentRequests PaymentRequest[]

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([name])
  @@index([sessionId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  retailCheckoutKey String? @unique
  retailPaymentDeadlineAt DateTime?
  retailPaymentExpiredAt DateTime?
  type        OrderType
  status      OrderStatus @default(PENDING)

  // Pricing
  subtotal    Decimal //@db.Decimal(12, 2)
  deliveryFee Decimal @default(0) //@db.Decimal(12, 2)
  tax         Decimal @default(0) //@db.Decimal(12, 2)
  discount    Decimal @default(0) //@db.Decimal(12, 2)
  total       Decimal //@db.Decimal(12, 2)

  // Delivery details
  deliveryAddress            String?
  deliveryLat                Decimal?
  deliveryLng                Decimal?
  estimatedDeliveryTime      DateTime?
  estimatedReadyAt           DateTime?
  preparationMinutesSnapshot Int?
  readyTimeVersion           Int       @default(0)
  deliveredAt                DateTime?

  // Notes
  notes String? //@db.Text

  // Payment
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus  @default(PENDING)
  paymentId     String?

  // Public tracking
  publicTrackingToken String? @unique

  // Promotion
  promotionId   String?
  promotionCode String?

  // Metadata
  organizationSlug String
  customerId       String?
  guestCustomerId  String?
  driverId         String?

  organization       Organization            @relation(fields: [organizationSlug], references: [slug])
  customer           User?                   @relation("CustomerOrderRelation", fields: [customerId], references: [id])
  guestCustomer      GuestCustomer?          @relation(fields: [guestCustomerId], references: [id])
  assignedDriver     User?                   @relation("DriverOrderRelation", fields: [driverId], references: [id])
  items              OrderItem[]
  payment            Payment?
  paymentEvents      PaymentEvent[]
  ussdPaymentIntents UssdPaymentIntent[]
  paymentRequests    PaymentRequest[]
  retailPaymentReports RetailPaymentReport[]
  statusHistory      OrderStatusHistory[]
  readyTimeHistory   OrderReadyTimeHistory[]
  inventoryMovements InventoryMovement[]
  promotion          Promotion?              @relation(fields: [promotionId], references: [id])
  loyaltyLedgers     LoyaltyLedger[]
  couponRedemptions  CouponRedemption[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  preparationProgressId String?   @unique
  preparationProgress   Progress? @relation("preparationProgressRelation", fields: [preparationProgressId], references: [id])

  pickupProgressId String?   @unique
  pickupProgress   Progress? @relation("pickupProgressRelation", fields: [pickupProgressId], references: [id])

  deliveryProgressId String?   @unique
  deliveryProgress   Progress? @relation("deliveryProgressRelation", fields: [deliveryProgressId], references: [id])

  denies Deny[]

  orderMessages OrderMessage[]

  @@index([organizationSlug])
  @@index([retailCheckoutKey, retailPaymentDeadlineAt, paymentStatus, status])
  @@index([customerId])
  @@index([driverId])
  @@index([preparationProgressId])
  @@index([pickupProgressId])
  @@index([deliveryProgressId])
  @@index([status])
  @@index([organizationSlug, estimatedReadyAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([orderNumber])
  @@index([publicTrackingToken])
  @@index([promotionId])
}

model OrderReadyTimeHistory {
  id                       String    @id @default(cuid())
  orderId                  String
  organizationId           String
  previousEstimatedReadyAt DateTime?
  estimatedReadyAt         DateTime
  preparationMinutes       Int
  reason                   String
  changedById              String
  version                  Int
  createdAt                DateTime  @default(now())

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changedBy    User         @relation("OrderReadyTimeChangedBy", fields: [changedById], references: [id])

  @@unique([orderId, version])
  @@index([organizationId, createdAt])
  @@index([changedById, createdAt])
}

model Progress {
  id               String    @id @default(cuid())
  startTime        DateTime?
  endTime          DateTime?
  estimatedEndTime DateTime?
  remMinutes       Float?
  percentage       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preparationProgress Order? @relation("preparationProgressRelation")
  pickupProgress      Order? @relation("pickupProgressRelation")
  deliveryProgress    Order? @relation("deliveryProgressRelation")
}

model OrderItem {
  id       String  @id @default(cuid())
  quantity Int
  price    Decimal //@db.Decimal(12, 2)

  // Immutable catalog details captured when the order is created. Legacy orders remain null.
  productNameSnapshot    String?
  skuSnapshot            String?
  variantNameSnapshot    String?
  variantOptionsSnapshot Json?

  // Optional discount per item
  discount Decimal @default(0) //@db.Decimal(12, 2)

  orderId   String
  productId String
  variantId String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model InventoryMovement {
  id             String                  @id @default(cuid())
  variantId      String
  orderId        String?
  quantityDelta  Int
  quantityBefore Int?
  quantityAfter  Int?
  reason         InventoryMovementReason
  note           String?
  createdById    String?
  retailReleaseKey String? @unique

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([orderId])
  @@index([reason])
  @@index([createdAt])
  @@index([createdById])
}

model Payment {
  id            String        @id @default(cuid())
  amount        Decimal //@db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  metadata      Json?

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
}

// Reports are claims or collection records until an authorized operator confirms
// them. The financial truth remains Order.paymentStatus and Payment.status.
model RetailPaymentReport {
  id               String                    @id @default(cuid())
  organizationId   String
  orderId          String
  submittedById    String
  kind             RetailPaymentReportKind
  status           RetailPaymentReportStatus @default(PENDING_REVIEW)
  receiptKey       String?
  reportedAt       DateTime?
  submittedContext Json?
  cashMode         String?
  collectorId      String?
  reviewedById     String?
  reviewedAt       DateTime?
  reviewReason     String?
  createdAt        DateTime                  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId, createdAt])
  @@index([organizationId, status, createdAt])
}

model PaymentEvent {
  id             String         @id @default(cuid())
  orderId        String
  previousStatus PaymentStatus?
  newStatus      PaymentStatus
  method         PaymentMethod?
  amount         Decimal?
  transactionId  String?
  note           String?
  createdById    String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([newStatus])
  @@index([createdAt])
  @@index([createdById])
}

model PaymentRequest {
  id                    String               @id @default(cuid())
  publicId              String               @unique @default(uuid())
  organizationId        String
  customerIdentityId    String?
  orderId               String?
  appointmentId         String?
  guestCustomerId       String?
  providerIntegrationId String?
  merchantAccountKey    String?
  credentialProfileKeySnapshot String?
  merchantCodeName      String?
  accountBoundAt        DateTime?
  amountToman           BigInt
  currency              String               @default("TOMAN")
  purpose               String
  status                PaymentRequestStatus @default(CREATED)
  providerReference     String?
  publicPaymentId       String               @unique @default(uuid())
  expiresAt             DateTime?
  paidAt                DateTime?
  failedAt              DateTime?
  cancelledAt           DateTime?
  metadata              Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerIdentity    CustomerIdentity?        @relation(fields: [customerIdentityId, organizationId], references: [id, organizationId], onDelete: NoAction)
  order               Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  appointment         Appointment?             @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  guestCustomer       GuestCustomer?           @relation(fields: [guestCustomerId], references: [id], onDelete: SetNull)
  providerIntegration OrganizationIntegration? @relation("PaymentRequestProviderIntegration", fields: [providerIntegrationId, organizationId], references: [id, organizationId], onDelete: NoAction)
  attempts            PaymentProviderAttempt[]
  ussdPaymentIntent   UssdPaymentIntent?

  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, orderId])
  @@index([organizationId, appointmentId])
  @@index([providerIntegrationId, status])
  @@index([customerIdentityId, createdAt])
}

model PaymentProviderAttempt {
  id                    String                       @id @default(cuid())
  organizationId        String
  paymentRequestId      String
  providerIntegrationId String?
  merchantAccountKey    String?
  credentialProfileKeySnapshot String?
  merchantCodeName      String?
  provider              IntegrationProvider
  status                PaymentProviderAttemptStatus @default(CREATED)
  amountToman           BigInt
  providerFactorId      String?
  merchantFactorId      String?
  rrn                   String?
  providerResult        String?
  callbackEvidence      Json?
  verificationEvidence  Json?
  failureReason         String?
  idempotencyKey        String?
  callbackReceivedAt    DateTime?
  verificationStartedAt DateTime?
  verifiedAt            DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentRequest      PaymentRequest           @relation(fields: [paymentRequestId, organizationId], references: [id, organizationId], onDelete: Cascade)
  providerIntegration OrganizationIntegration? @relation(fields: [providerIntegrationId, organizationId], references: [id, organizationId], onDelete: NoAction)
  ussdPaymentIntent   UssdPaymentIntent?
  verificationJobs   UssdPaymentVerificationJob[]

  @@unique([id, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@unique([providerIntegrationId, merchantFactorId])
  @@unique([merchantAccountKey, merchantFactorId])
  @@unique([providerIntegrationId, providerFactorId])
  @@unique([providerIntegrationId, rrn])
  @@index([organizationId, status, createdAt])
  @@index([paymentRequestId, status])
  @@index([providerIntegrationId, status])
}

model UssdSession {
  id              String            @id @default(cuid())
  publicId        String            @unique @default(uuid())
  organizationId  String
  integrationId   String
  customerIdentityId String?
  sessionIdHash   String
  customerId      String?
  guestCustomerId String?
  status          UssdSessionStatus @default(STARTED)
  state           Json?
  metadata        Json?
  startedAt       DateTime          @default(now())
  lastSeenAt      DateTime          @default(now())
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration   OrganizationIntegration @relation(fields: [integrationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  customerIdentity CustomerIdentity?    @relation(fields: [customerIdentityId, organizationId], references: [id, organizationId], onDelete: NoAction)
  customer      User?                   @relation("UssdSessionCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  guestCustomer GuestCustomer?          @relation(fields: [guestCustomerId], references: [id], onDelete: SetNull)

  @@unique([integrationId, sessionIdHash])
  @@index([organizationId, status, lastSeenAt])
  @@index([integrationId, status, lastSeenAt])
  @@index([customerIdentityId, lastSeenAt])
  @@index([customerId, lastSeenAt])
  @@index([guestCustomerId, lastSeenAt])
}

model UssdPaymentIntent {
  id                   String                  @id @default(cuid())
  organizationId       String
  integrationId        String
  orderId              String?
  paymentRequestId     String?
  providerAttemptId    String?                 @unique
  merchantAccountKey   String
  credentialProfileKeySnapshot String?
  merchantCodeName     String
  merchantFactorId     String
  amountRial           BigInt
  sessionIdHash        String
  mobileHash           String
  mobileMasked         String
  status               UssdPaymentIntentStatus @default(REQUESTED)
  providerFactorId     String?
  rrn                   String?
  providerResult       String?
  verifiedAt           DateTime?
  settledAt            DateTime?
  notificationAttemptedAt DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  OrganizationIntegration @relation(fields: [integrationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  order        Order?                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentRequest PaymentRequest?       @relation(fields: [paymentRequestId, organizationId], references: [id, organizationId], onDelete: NoAction)
  providerAttempt PaymentProviderAttempt? @relation(fields: [providerAttemptId, organizationId], references: [id, organizationId], onDelete: NoAction)
  callbackEvents UssdCallbackEvent[]
  verificationJob UssdPaymentVerificationJob?

  @@unique([merchantAccountKey, merchantFactorId])
  @@unique([integrationId, orderId, sessionIdHash])
  @@unique([id, integrationId, organizationId])
  @@unique([providerAttemptId, organizationId])
  @@unique([paymentRequestId, organizationId])
  @@unique([integrationId, providerFactorId])
  @@unique([integrationId, rrn])
  @@index([organizationId, status, createdAt])
  @@index([integrationId, status, createdAt])
  @@index([orderId, status])
  @@index([paymentRequestId, status])
}

model UssdPaymentVerificationJob {
  id                     String                           @id @default(cuid())
  organizationId         String
  integrationId          String
  paymentIntentId        String                           @unique
  providerAttemptId      String?
  status                 UssdPaymentVerificationJobStatus @default(QUEUED)
  encryptedCorrelation   Json?
  correlationFingerprint String
  encryptionKeyVersion   Int
  attemptCount           Int                              @default(0)
  nextAttemptAt          DateTime                         @default(now())
  lastAttemptAt          DateTime?
  lastFailureClass       String?
  leaseToken             String?
  leaseExpiresAt         DateTime?
  completedAt            DateTime?
  correlationRetiredAt   DateTime?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration     OrganizationIntegration @relation(fields: [integrationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  paymentIntent   UssdPaymentIntent       @relation(fields: [paymentIntentId, integrationId, organizationId], references: [id, integrationId, organizationId], onDelete: Cascade)
  providerAttempt PaymentProviderAttempt? @relation(fields: [providerAttemptId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@unique([id, organizationId])
  @@unique([paymentIntentId, integrationId, organizationId])
  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@index([organizationId, status, updatedAt])
  @@index([integrationId, status, nextAttemptAt])
}

model UssdCallbackEvent {
  id              String              @id @default(cuid())
  organizationId  String
  integrationId   String
  paymentIntentId String?
  idempotencyKey  String              @unique
  sessionIdHash   String
  mobileHash      String
  callHash        String
  rrnHash         String?
  outcome         UssdCallbackOutcome
  errorCode       String?
  createdAt       DateTime            @default(now())

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration   OrganizationIntegration @relation(fields: [integrationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  paymentIntent UssdPaymentIntent?      @relation(fields: [paymentIntentId, integrationId, organizationId], references: [id, integrationId, organizationId], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([integrationId, createdAt])
  @@index([paymentIntentId, createdAt])
  @@index([outcome, createdAt])
}

model UssdEvent {
  id              String        @id @default(cuid())
  publicId        String        @unique @default(uuid())
  organizationId  String
  integrationId   String
  sessionIdHash   String
  eventType       UssdEventType
  metadata        Json?
  createdAt       DateTime      @default(now())

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration   OrganizationIntegration @relation(fields: [integrationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([integrationId, createdAt])
  @@index([sessionIdHash, createdAt])
  @@index([eventType, createdAt])
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String
  previousStatus OrderStatus?
  newStatus      OrderStatus
  note           String?
  changedById    String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([newStatus])
  @@index([createdAt])
  @@index([changedById])
}

model Promotion {
  id             String   @id @default(cuid())
  code           String   @unique
  description    String?
  discountType   String // "percentage" | "fixed"
  discountValue  Decimal //@db.Decimal(12, 2)
  minOrderAmount Decimal? //@db.Decimal(12, 2)
  maxUses        Int?
  usedCount      Int      @default(0)
  startsAt       DateTime
  expiresAt      DateTime
  isActive       Boolean  @default(true)

  organizationSlug String
  organization     Organization @relation(fields: [organizationSlug], references: [slug])

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationSlug])
  @@index([code])
  @@index([expiresAt])
  @@index([isActive])
}

// --- SOCIAL & FEEDBACK ---

model Review {
  id       String  @id @default(cuid())
  publicId String  @unique @default(uuid())
  rating   Int     @default(5)
  title    String?
  comment  String? //@db.Text
  text     String? @db.Text

  // Review metadata
  isVerifiedPurchase Boolean @default(false)
  status              ReviewStatus @default(PUBLISHED)
  source              ReviewSource @default(CUSTOMER_PORTAL)
  verifiedInteraction Boolean      @default(false)
  verifiedAt          DateTime?

  userId           String?
  organizationId   String?
  organizationSlug String
  customerIdentityId    String?
  reviewRequestId       String?
  businessEventId       String?
  customerInteractionId String?
  businessEntityId      String?
  contextType           String?
  contextId             String?
  productId             String?
  serviceId             String?
  appointmentId         String?
  orderId               String?
  staffUserId           String?
  responseText          String? @db.Text
  respondedAt           DateTime?
  metadata              Json?

  user                User?                @relation("UserReviews", fields: [userId], references: [id])
  organization        Organization         @relation("OrgReviews", fields: [organizationSlug], references: [slug])
  reputationOrganization Organization?     @relation("OrganizationReputationReviews", fields: [organizationId], references: [id], onDelete: Cascade)
  customerIdentity    CustomerIdentity?    @relation(fields: [customerIdentityId, organizationId], references: [id, organizationId], onDelete: Cascade)
  reviewRequest       ReviewRequest?       @relation(fields: [reviewRequestId], references: [id], onDelete: SetNull)
  businessEvent       BusinessEvent?       @relation(fields: [businessEventId], references: [id], onDelete: SetNull)
  customerInteraction CustomerInteraction? @relation(fields: [customerInteractionId], references: [id], onDelete: SetNull)
  businessEntity      BusinessEntity?      @relation(fields: [businessEntityId, organizationId], references: [id, organizationId], onDelete: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationSlug]) // One review per user per org
  @@index([organizationSlug])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerIdentityId, createdAt])
  @@index([organizationId, verifiedInteraction])
  @@index([organizationId, contextType, contextId])
  @@index([businessEntityId])
  @@index([rating])
}

model FanpagePost {
  id             String    @id @default(cuid())
  organizationId String
  authorId       String
  title          String?
  body           String    @db.Text
  image          String?
  video          String?
  isPublished    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([organizationId, isPublished, deletedAt, createdAt])
  @@index([authorId])
}

model ExternalImportSource {
  id               String                     @id @default(cuid())
