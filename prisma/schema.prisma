  aiMediaJobMirrors             AiMediaJobMirror[]            @relation("AiMediaJobRequestedBy")
  aiMediaJobEvents              AiMediaJobEvent[]             @relation("AiMediaJobEventActor")
  aiMediaAssets                 AiMediaAsset[]                @relation("AiMediaAssetRequestedBy")
  aiMediaUsageQuotes            AiMediaUsageQuote[]           @relation("AiMediaQuoteRequestedBy")
  aiMediaSpendHolds             AiMediaSpendHold[]            @relation("AiMediaSpendHoldRequestedBy")
