// --- CORE MODELS ---

model TimeInterval {
  id    String    @id @default(cuid())
  start DateTime?
  end   DateTime?
  note  String?

  appointments Appointment[]
}

model Organization {
  id                        String           @id @default(cuid())
  type                      OrganizationType
  locale                    String           @default("fa")
  timezone                  String           @default("Asia/Tehran")
  name                      String
  slug                      String           @unique
  description               String? //@db.Text
  address                   String?
  phone                     String?
  email                     String?
  logo                      String?
  coverImage                String?
  lat                       Float?
  lng                       Float?
  isActive                  Boolean          @default(true)
  isOpen                    Boolean          @default(true)
  capabilitiesInitializedAt DateTime?

  // Timestamps & Soft Delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  members                      OrganizationMember[]
  capabilities                 OrganizationCapability[]
  ownedCollaborations          OrganizationCollaboration[]   @relation("CollaborationOwner")
  partnerCollaborations        OrganizationCollaboration[]   @relation("CollaborationPartner")
  readyTimeHistory             OrderReadyTimeHistory[]
  businessHours                BusinessHour[]
  serviceCategories            ServiceCategory[]
  services                     Service[]
  productCategories            ProductCategory[]
  products                     Product[]
  carts                        ShopCart[]
  orders                       Order[]
  followers                    Follow[]
  customerClubMemberships      CustomerClubMembership[]
  customerSegments             CustomerSegment[]
  customerSegmentSnapshots     CustomerSegmentSnapshot[]
  campaigns                    Campaign[]
  campaignDeliveries           CampaignDelivery[]
  loyaltyLedgers               LoyaltyLedger[]
  loyaltyRules                 LoyaltyRule[]
  coupons                      Coupon[]
  couponRedemptions            CouponRedemption[]
  pushSubscriptions            PushSubscription[]
  notificationPermissionEvents NotificationPermissionEvent[]
  notificationPreferences      NotificationPreference[]
  webPushDeliveries            WebPushDelivery[]
  smsDeliveries                SmsDelivery[]
  fanpagePosts                 FanpagePost[]
  notifications                Notification[]
  locations                    Location[]
  reviews                      Review[]                      @relation("OrgReviews")
  images                       Image[]                       @relation("OrganizationImages")
  settings                     OrganizationSettings?
  bookingSettings              BookingSettings?
  promotions                   Promotion[]
  auditLogs                    AuditLog[]
  staffAvailability            StaffAvailability[]
  bookingSessions              BookingSession[]
  domains                      OrganizationDomain[]
  externalImportSources        ExternalImportSource[]
  externalImportJobs           ExternalImportJob[]
  importedProductDrafts        ImportedProductDraft[]
  importedContentDrafts        ImportedContentDraft[]
  exportJobs                   ExportJob[]
  aiMediaRequests              AiMediaRequest[]
  aiMediaJobMirrors            AiMediaJobMirror[]
  aiMediaJobEvents             AiMediaJobEvent[]
  aiMediaImports               AiMediaImport[]
  aiMediaAssets                AiMediaAsset[]
  aiMediaUsageQuotes           AiMediaUsageQuote[]
  aiMediaSpendHolds            AiMediaSpendHold[]
  workerContributionMirrors    WorkerContributionMirror[]
  paymentSettings              PaymentSettings?

  @@unique([id, slug])
  @@unique([id])
  @@index([type])
  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
  @@index([id, slug])
  @@index([id])
}

model OrganizationCapability {
  id             String                       @id @default(cuid())
  organizationId String
  key            OrganizationCapabilityKey
  status         OrganizationCapabilityStatus @default(ACTIVE)
  settings       Json?
  enabledAt      DateTime?
  disabledAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@index([key, status])
}

model OrganizationCollaboration {
  id              String                             @id @default(cuid())
  ownerOrgId      String
  partnerOrgId    String
  status          OrganizationCollaborationStatus    @default(PENDING)
  direction       OrganizationCollaborationDirection @default(TWO_WAY)
  invitedById     String
  acceptedById    String?
  revokedById     String?
  startsAt        DateTime?
  endsAt          DateTime?
  acceptedAt      DateTime?
  revokedAt       DateTime?
  retentionPolicy Json?
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt

  ownerOrg   Organization                     @relation("CollaborationOwner", fields: [ownerOrgId], references: [id], onDelete: Cascade)
  partnerOrg Organization                     @relation("CollaborationPartner", fields: [partnerOrgId], references: [id], onDelete: Cascade)
  invitedBy  User                             @relation("CollaborationInvitedBy", fields: [invitedById], references: [id])
  acceptedBy User?                            @relation("CollaborationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedBy  User?                            @relation("CollaborationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  scopes     OrganizationCollaborationScope[]

  @@unique([ownerOrgId, partnerOrgId])
  @@index([ownerOrgId, status])
  @@index([partnerOrgId, status])
  @@index([createdAt])
}

model OrganizationCollaborationScope {
  id              String                            @id @default(cuid())
  collaborationId String
  scope           OrganizationCollaborationScopeKey
  ownerToPartner  Boolean                           @default(false)
  partnerToOwner  Boolean                           @default(false)
  writeAccess     Boolean                           @default(false)
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  collaboration OrganizationCollaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@unique([collaborationId, scope])
  @@index([scope])
}

model OrganizationDomain {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  domain           String         @unique
  normalizedDomain String         @unique
  kind             DomainKind     @default(SUBDOMAIN)
  provider         DomainProvider @default(VERCEL)
  type             DomainType     @default(CUSTOM)
  status           DomainStatus   @default(REQUESTED)
  isPrimary        Boolean        @default(false)

  providerVerified Boolean @default(false)
  dnsConfigured    Boolean @default(false)
  sslReady         Boolean @default(false)

  vercelProjectDomainId String?
  verificationToken     String?
  verificationType      String?
  verificationDomain    String?
  verificationValue     String?
  verifiedAt            DateTime?
  lastCheckedAt         DateTime?
  activatedAt           DateTime?
  disabledAt            DateTime?
  removedAt             DateTime?
  reviewedAt            DateTime?
  failureReason         String?
  lastErrorCode         String?
  lastErrorMessage      String?

  createdById  String?
  updatedById  String?
  reviewedById String?
  createdBy    User?   @relation("DomainCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?   @relation("DomainUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  reviewedBy   User?   @relation("DomainReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([status])
  @@index([isPrimary])
  @@index([organizationId, status])
  @@index([organizationId, kind])
  @@index([normalizedDomain, status])
}

model Deny {
  id      String @id @default(cuid())
  orderId String
  userId  String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([orderId, userId])
}

model Notification {
  id                 String             @id @default(cuid())
  targetUserId       String
  context            String
  organizationId     String?
  createdByUserId    String?
  targetUser         User               @relation("TargetNotifications", fields: [targetUserId], references: [id])
  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          User?              @relation("CreatedNotifications", fields: [createdByUserId], references: [id], onDelete: SetNull)
  campaignDeliveries CampaignDelivery[]
  seen               Boolean            @default(false)
  type               String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  readAt             DateTime?

  @@index([targetUserId])
  @@index([targetUserId, seen, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdByUserId])
}

model User {
  id           String   @id @default(cuid())
  password     String
  name         String   @unique
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  isTeamMember Boolean  @default(false)
  email        String?  @unique
  firstName    String?
  lastName     String?
  phone        String?
  avatar       String?
  image        String?
  address      String?
  status       String?

  // Email verification
  emailVerified DateTime?

  // User Preferences
  locale String @default("fa")
  theme  String @default("system")

  // Security
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Timestamps & Soft Delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  memberOf                      OrganizationMember[]
  providedServices              Service[]                     @relation("ServiceProviderRelation")
  appointments                  Appointment[]                 @relation("CustomerAppointmentRelation")
  carts                         ShopCart[]
  orders                        Order[]                       @relation("CustomerOrderRelation")
  assignedDeliveries            Order[]                       @relation("DriverOrderRelation")
  following                     Follow[]
  customerClubMemberships       CustomerClubMembership[]
  fanpagePosts                  FanpagePost[]
  sentMessages                  Message[]                     @relation("SentMessages")
  receivedMessages              Message[]                     @relation("ReceivedMessages")
  locations                     Location[]
  reviewsWritten                Review[]                      @relation("UserReviews")
  notifications                 Notification[]                @relation("TargetNotifications")
  createdNotifications          Notification[]                @relation("CreatedNotifications")
  createdCampaigns              Campaign[]                    @relation("CreatedCampaigns")
  campaignDeliveries            CampaignDelivery[]            @relation("CampaignTargetDeliveries")
  loyaltyLedgers                LoyaltyLedger[]               @relation("CustomerLoyaltyLedger")
  createdLoyaltyLedgers         LoyaltyLedger[]               @relation("CreatedLoyaltyLedger")
  couponRedemptions             CouponRedemption[]            @relation("CustomerCouponRedemptions")
  pushSubscriptions             PushSubscription[]            @relation("CustomerPushSubscriptions")
  notificationPermissionEvents  NotificationPermissionEvent[] @relation("CustomerNotificationPermissionEvents")
  notificationPreferences       NotificationPreference[]      @relation("CustomerNotificationPreferences")
  webPushDeliveries             WebPushDelivery[]             @relation("CustomerWebPushDeliveries")
  actorWebPushDeliveries        WebPushDelivery[]             @relation("ActorWebPushDeliveries")
  smsDeliveries                 SmsDelivery[]                 @relation("CustomerSmsDeliveries")
  actorSmsDeliveries            SmsDelivery[]                 @relation("ActorSmsDeliveries")
  passwordResets                PasswordReset[]
  emailVerifications            EmailVerification[]
  auditLogs                     AuditLog[]
  createdDomains                OrganizationDomain[]          @relation("DomainCreatedBy")
  updatedDomains                OrganizationDomain[]          @relation("DomainUpdatedBy")
  reviewedDomains               OrganizationDomain[]          @relation("DomainReviewedBy")
  invitedCollaborations         OrganizationCollaboration[]   @relation("CollaborationInvitedBy")
  acceptedCollaborations        OrganizationCollaboration[]   @relation("CollaborationAcceptedBy")
  revokedCollaborations         OrganizationCollaboration[]   @relation("CollaborationRevokedBy")
  orderReadyTimeChanges         OrderReadyTimeHistory[]       @relation("OrderReadyTimeChangedBy")
  conversationParticipants      ConversationParticipant[]
  businessHours                 BusinessHour[]
  uploadedImages                Image[]                       @relation("UploadedImages")
  createdImportSources          ExternalImportSource[]        @relation("ExternalImportSourceCreatedBy")
  requestedImportJobs           ExternalImportJob[]           @relation("ExternalImportJobRequestedBy")
  requestedExportJobs           ExportJob[]                   @relation("ExportJobRequestedBy")
  reviewedImportedProductDrafts ImportedProductDraft[]        @relation("ImportedProductDraftReviewedBy")
  reviewedImportedContentDrafts ImportedContentDraft[]        @relation("ImportedContentDraftReviewedBy")
  aiMediaRequests               AiMediaRequest[]              @relation("AiMediaRequestRequestedBy")
  aiMediaJobMirrors             AiMediaJobMirror[]            @relation("AiMediaJobRequestedBy")
  aiMediaJobEvents              AiMediaJobEvent[]             @relation("AiMediaJobEventActor")
  aiMediaAssets                 AiMediaAsset[]                @relation("AiMediaAssetRequestedBy")
  aiMediaUsageQuotes            AiMediaUsageQuote[]           @relation("AiMediaQuoteRequestedBy")
  aiMediaSpendHolds             AiMediaSpendHold[]            @relation("AiMediaSpendHoldRequestedBy")

  denies                          Deny[]
  orderMessages                   OrderMessage[]
  reviewedLeads                   RequestDemoLead[]        @relation("LeadReviewerRelation")
  createdTenantProvisioningPlans  TenantProvisioningPlan[] @relation("TenantProvisioningPlanCreatedBy")
  updatedTenantProvisioningPlans  TenantProvisioningPlan[] @relation("TenantProvisioningPlanUpdatedBy")
  approvedTenantProvisioningPlans TenantProvisioningPlan[] @relation("TenantProvisioningPlanApprovedBy")

  @@index([email])
  @@index([name])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@index([emailVerified])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole @default(STAFF)
  isActive       Boolean  @default(true)
  joinedAt       DateTime @default(now())

  organizationSlug String

  organization Organization @relation(fields: [organizationId, organizationSlug], references: [id, slug])

  user         User                @relation(fields: [userId], references: [id])
  availability StaffAvailability[]

  @@unique([organizationId, userId])
  //@@index([organizationSlug, userId])
  @@index([organizationSlug])
  @@index([organizationId])
  @@index([userId])
}

model BusinessHour {
  id        String    @id @default(cuid())
  day       DayOfWeek
  openTime  String // Format "HH:mm"
  closeTime String // Format "HH:mm"
  isOpen    Boolean   @default(true)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, day, userId])
  @@index([organizationId])
}

// --- AUTHENTICATION MODELS ---
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String    @unique
  token      String    @unique
  email      String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

// --- APPOINTMENT MODELS ---
model ServiceCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String?
  description String? //@db.Text
  image       String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  services Service[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([organizationId, slug])
  @@index([deletedAt])
}

model Service {
  id                    String  @id @default(cuid())
  name                  String
  slug                  String?
  description           String? //@db.Text
  price                 Decimal //@db.Decimal(12, 2)
  duration              Int // In minutes
  image                 String?
  aiPrimaryMediaAssetId String?
  isActive              Boolean @default(true)
  sortOrder             Int     @default(0)

  organizationId    String
  categoryId        String
  serviceProviderId String?

  organization        Organization    @relation(fields: [organizationId], references: [id])
  category            ServiceCategory @relation(fields: [categoryId], references: [id])
  serviceProvider     User?           @relation("ServiceProviderRelation", fields: [serviceProviderId], references: [id])
  aiPrimaryMediaAsset AiMediaAsset?   @relation("ServiceAiPrimaryMediaAsset", fields: [aiPrimaryMediaAssetId], references: [id], onDelete: SetNull)
  appointments        Appointment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([organizationId, slug])
  @@index([categoryId])
  @@index([serviceProviderId])
  @@index([aiPrimaryMediaAssetId])
  @@index([deletedAt])
}

model Appointment {
  id        String            @id @default(cuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(PENDING)
  notes     String? //@db.Text

  timeInterval   TimeInterval? @relation(fields: [timeIntervalid], references: [id])
  timeIntervalid String?

  // Cancellation details
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledBy        String?

  // Confirmation details
  confirmedAt DateTime?
  confirmedBy String?

  // Reminder tracking
  reminderSentAt DateTime?
  reminderSentBy String?
  followUpSentAt DateTime?
  followUpSentBy String?

  // Customer contact info at booking time (for guests)
  customerNameAtBooking  String?
  customerPhoneAtBooking String?
  customerEmailAtBooking String?

  // Booking reference for guest lookup
  bookingReference String? @unique

  customerId      String?
  customer        User?          @relation("CustomerAppointmentRelation", fields: [customerId], references: [id])
  guestCustomerId String?
  guestCustomer   GuestCustomer? @relation(fields: [guestCustomerId], references: [id])

  serviceId String

  service Service @relation(fields: [serviceId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([guestCustomerId])
  @@index([serviceId])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
  @@index([bookingReference])
}

// Staff availability for service providers
model StaffAvailability {
  id          String    @id @default(cuid())
  dayOfWeek   DayOfWeek
  startTime   String // Format "HH:mm"
  endTime     String // Format "HH:mm"
  isAvailable Boolean   @default(true)
  breakStart  String? // Format "HH:mm"
  breakEnd    String? // Format "HH:mm"

  // Specific date override (for vacations, special hours, etc.)
  specificDate DateTime?
  isDayOff     Boolean   @default(false)

  organizationId String
  staffId        String

  organization Organization       @relation(fields: [organizationId], references: [id])
  staff        OrganizationMember @relation(fields: [staffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, dayOfWeek, specificDate])
  @@index([organizationId])
  @@index([staffId])
  @@index([specificDate])
}

// Booking session for tracking booking attempts and analytics
model BookingSession {
  id             String    @id @default(cuid())
  sessionId      String    @unique
  organizationId String
  serviceId      String?
  selectedDate   DateTime?
  selectedTime   String?
  customerName   String?
  customerPhone  String?
  customerEmail  String?
  status         String    @default("started") // started, service_selected, datetime_selected, completed, abandoned
  completedAt    DateTime?
  abandonedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([organizationId])
  @@index([sessionId])
  @@index([status])
  @@index([expiresAt])
}

// --- SHOP MODELS ---

model ProductCategory {
  id               String  @id @default(cuid())
  name             String
  slug             String?
  description      String? //@db.Text
  image            String?
  sortOrder        Int     @default(0)
  isActive         Boolean @default(true)
  organizationId   String
  organizationSlug String

  organization Organization @relation(fields: [organizationId, organizationSlug], references: [id, slug])
  products     Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([organizationSlug])
  @@index([organizationId, slug])
  @@index([deletedAt])
}

model Image {
  id        String      @id @default(cuid())
  url       String
  filename  String?
  mimeType  String?
  sizeBytes Int?
  purpose   String      @default("upload")
  access    ImageAccess @default(PUBLIC)

  uploadedByUserId String?
  organizationId   String?

  createdAt DateTime @default(now())

  uploadedBy   User?         @relation("UploadedImages", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation("OrganizationImages", fields: [organizationId], references: [id], onDelete: SetNull)
  products     Product[]

  @@index([uploadedByUserId])
  @@index([organizationId])
  @@index([purpose])
  @@index([access])
  @@index([createdAt])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String?
  description String? //@db.Text
  basePrice   Decimal //@db.Decimal(12, 2)

  image                 String?
  images                Image[]
  aiPrimaryMediaAssetId String?
  sku                   String?
  isActive              Boolean @default(true)
  sortOrder             Int     @default(0)
  preparationMinutes    Int?

  // Inventory management

  trackInventory    Boolean @default(true)
  lowStockThreshold Int     @default(10)

  // Pricing / discount

  discountType  String?  @default("none") // "none" | "percentage" | "fixed"
  discountValue Decimal? @default(0) //@db.Decimal(12, 2)

  organizationId   String
  organizationSlug String
  categoryId       String

  organization        Organization     @relation(fields: [organizationId, organizationSlug], references: [id, slug])
  category            ProductCategory  @relation(fields: [categoryId], references: [id])
  aiPrimaryMediaAsset AiMediaAsset?    @relation("ProductAiPrimaryMediaAsset", fields: [aiPrimaryMediaAssetId], references: [id], onDelete: SetNull)
  variants            ProductVariant[]
  orderItems          OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([organizationSlug])
  @@index([organizationId, slug])
  @@index([organizationSlug, slug])
  @@index([categoryId])
  @@index([aiPrimaryMediaAssetId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([sku])
}

model ProductVariant {
  id        String   @id @default(cuid())
  sku       String?  @unique
  name      String? // e.g., "Large / Red"
  image     String?
  price     Decimal? //@db.Decimal(12, 2) // Override basePrice if set
  inventory Int      @default(0)

  // Stock management
  reservedQuantity Int     @default(0)
  allowBackOrder   Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItems          ShopCartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId])
  @@index([deletedAt])
}

model ShopCart {
  id     String     @id @default(cuid())
  status CartStatus @default(ACTIVE)

  organizationSlug String
  organization     Organization @relation(fields: [organizationSlug], references: [slug])

  customerId String?
  customer   User?   @relation(fields: [customerId], references: [id])

  sessionId String?

  expiresAt DateTime? // Cart expiration (e.g., 7 days)

  items ShopCartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationSlug, customerId])
  @@unique([organizationSlug, sessionId])
  @@index([status])
  @@index([customerId])
  @@index([organizationSlug, customerId])
  @@index([sessionId])
  @@index([organizationSlug, sessionId])
}

model ShopCartItem {
  id       String @id @default(cuid())
  quantity Int

  cartId    String
  variantId String

  cart    ShopCart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([variantId])
}

// Guest Customer 
model GuestCustomer {
  id        String  @id @default(cuid())
  name      String
  firstName String?
  lastName  String?
  sessionId String  @unique
  phone     String?
  email     String?
  address   String?

  appointments Appointment[]
  orders       Order[]

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([name])
  @@index([sessionId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  type        OrderType
  status      OrderStatus @default(PENDING)

  // Pricing
  subtotal    Decimal //@db.Decimal(12, 2)
  deliveryFee Decimal @default(0) //@db.Decimal(12, 2)
  tax         Decimal @default(0) //@db.Decimal(12, 2)
  discount    Decimal @default(0) //@db.Decimal(12, 2)
  total       Decimal //@db.Decimal(12, 2)

  // Delivery details
  deliveryAddress            String?
  deliveryLat                Decimal?
  deliveryLng                Decimal?
  estimatedDeliveryTime      DateTime?
  estimatedReadyAt           DateTime?
  preparationMinutesSnapshot Int?
  readyTimeVersion           Int       @default(0)
  deliveredAt                DateTime?

  // Notes
  notes String? //@db.Text

  // Payment
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus  @default(PENDING)
  paymentId     String?

  // Public tracking
  publicTrackingToken String? @unique

  // Promotion
  promotionId   String?
  promotionCode String?

  // Metadata
  organizationSlug String
  customerId       String?
  guestCustomerId  String?
  driverId         String?

  organization       Organization            @relation(fields: [organizationSlug], references: [slug])
  customer           User?                   @relation("CustomerOrderRelation", fields: [customerId], references: [id])
  guestCustomer      GuestCustomer?          @relation(fields: [guestCustomerId], references: [id])
  assignedDriver     User?                   @relation("DriverOrderRelation", fields: [driverId], references: [id])
  items              OrderItem[]
  payment            Payment?
  paymentEvents      PaymentEvent[]
  statusHistory      OrderStatusHistory[]
  readyTimeHistory   OrderReadyTimeHistory[]
  inventoryMovements InventoryMovement[]
  promotion          Promotion?              @relation(fields: [promotionId], references: [id])
  loyaltyLedgers     LoyaltyLedger[]
  couponRedemptions  CouponRedemption[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  preparationProgressId String?   @unique
  preparationProgress   Progress? @relation("preparationProgressRelation", fields: [preparationProgressId], references: [id])

  pickupProgressId String?   @unique
  pickupProgress   Progress? @relation("pickupProgressRelation", fields: [pickupProgressId], references: [id])

  deliveryProgressId String?   @unique
  deliveryProgress   Progress? @relation("deliveryProgressRelation", fields: [deliveryProgressId], references: [id])

  denies Deny[]

  orderMessages OrderMessage[]

  @@index([organizationSlug])
  @@index([customerId])
  @@index([driverId])
  @@index([preparationProgressId])
  @@index([pickupProgressId])
  @@index([deliveryProgressId])
  @@index([status])
  @@index([organizationSlug, estimatedReadyAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([orderNumber])
  @@index([publicTrackingToken])
  @@index([promotionId])
}

model OrderReadyTimeHistory {
  id                       String    @id @default(cuid())
  orderId                  String
  organizationId           String
  previousEstimatedReadyAt DateTime?
  estimatedReadyAt         DateTime
  preparationMinutes       Int
  reason                   String
  changedById              String
  version                  Int
  createdAt                DateTime  @default(now())

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changedBy    User         @relation("OrderReadyTimeChangedBy", fields: [changedById], references: [id])

  @@unique([orderId, version])
  @@index([organizationId, createdAt])
  @@index([changedById, createdAt])
}

model Progress {
  id               String    @id @default(cuid())
  startTime        DateTime?
  endTime          DateTime?
  estimatedEndTime DateTime?
  remMinutes       Float?
  percentage       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preparationProgress Order? @relation("preparationProgressRelation")
  pickupProgress      Order? @relation("pickupProgressRelation")
  deliveryProgress    Order? @relation("deliveryProgressRelation")
}

model OrderItem {
  id       String  @id @default(cuid())
  quantity Int
  price    Decimal //@db.Decimal(12, 2)

  // Optional discount per item
  discount Decimal @default(0) //@db.Decimal(12, 2)

  orderId   String
  productId String
  variantId String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model InventoryMovement {
  id             String                  @id @default(cuid())
  variantId      String
  orderId        String?
  quantityDelta  Int
  quantityBefore Int?
  quantityAfter  Int?
  reason         InventoryMovementReason
  note           String?
  createdById    String?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([orderId])
  @@index([reason])
  @@index([createdAt])
  @@index([createdById])
}

model Payment {
  id            String        @id @default(cuid())
  amount        Decimal //@db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  metadata      Json?

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
}

model PaymentEvent {
  id             String         @id @default(cuid())
  orderId        String
  previousStatus PaymentStatus?
  newStatus      PaymentStatus
  method         PaymentMethod?
  amount         Decimal?
  transactionId  String?
  note           String?
  createdById    String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([newStatus])
  @@index([createdAt])
  @@index([createdById])
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String
  previousStatus OrderStatus?
  newStatus      OrderStatus
  note           String?
  changedById    String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([newStatus])
  @@index([createdAt])
  @@index([changedById])
}

model Promotion {
  id             String   @id @default(cuid())
  code           String   @unique
  description    String?
  discountType   String // "percentage" | "fixed"
  discountValue  Decimal //@db.Decimal(12, 2)
  minOrderAmount Decimal? //@db.Decimal(12, 2)
  maxUses        Int?
  usedCount      Int      @default(0)
  startsAt       DateTime
  expiresAt      DateTime
  isActive       Boolean  @default(true)

  organizationSlug String
  organization     Organization @relation(fields: [organizationSlug], references: [slug])

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationSlug])
  @@index([code])
  @@index([expiresAt])
  @@index([isActive])
}

// --- SOCIAL & FEEDBACK ---

model Review {
  id      String  @id @default(cuid())
  rating  Int     @default(5)
  comment String? //@db.Text

  // Review metadata
  isVerifiedPurchase Boolean @default(false)

  userId           String
  organizationSlug String

  user         User         @relation("UserReviews", fields: [userId], references: [id])
  organization Organization @relation("OrgReviews", fields: [organizationSlug], references: [slug])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationSlug]) // One review per user per org
  @@index([organizationSlug])
  @@index([rating])
}

model FanpagePost {
  id             String    @id @default(cuid())
  organizationId String
  authorId       String
  title          String?
  body           String    @db.Text
  image          String?
  video          String?
  isPublished    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([organizationId, isPublished, deletedAt, createdAt])
  @@index([authorId])
}

model ExternalImportSource {
  id               String                     @id @default(cuid())
  organizationId   String
  type             ExternalImportSourceType
  status           ExternalImportSourceStatus @default(DRAFT)
  displayName      String?
  sourceUrl        String?
  normalizedUrl    String?
  consentConfirmed Boolean                    @default(false)
  consentText      String?
  metadata         Json?
  createdByUserId  String?
  lastImportedAt   DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User?                  @relation("ExternalImportSourceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  jobs          ExternalImportJob[]
  productDrafts ImportedProductDraft[]
  contentDrafts ImportedContentDraft[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([normalizedUrl])
  @@index([createdByUserId])
}

model ExternalImportJob {
  id                String                   @id @default(cuid())
  organizationId    String
  sourceId          String?
  type              ExternalImportSourceType
  status            ExternalImportJobStatus  @default(QUEUED)
  inputUrl          String?
  inputText         String?
  inputFilename     String?
  consentConfirmed  Boolean                  @default(false)
  consentText       String?
  errorMessage      String?
  summary           Json?
  requestedByUserId String?
  startedAt         DateTime?
  completedAt       DateTime?
  canceledAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source        ExternalImportSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  requestedBy   User?                  @relation("ExternalImportJobRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  productDrafts ImportedProductDraft[]
  contentDrafts ImportedContentDraft[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([sourceId])
  @@index([requestedByUserId])
  @@index([createdAt])
}

model ExportJob {
  id                String          @id @default(cuid())
  organizationId    String
  type              ExportDataType
  format            ExportJobFormat @default(JSON)
  status            ExportJobStatus @default(QUEUED)
  fileName          String?
  mimeType          String?
  payload           Json?
  rowCount          Int             @default(0)
  errorMessage      String?
  requestedByUserId String?
  completedAt       DateTime?
  canceledAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation("ExportJobRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([requestedByUserId])
  @@index([createdAt])
}

model AiMediaJob {
  id                String   @id @default(cuid())
  jobId             String   @unique
  organizationId    String
  productId         String
  requestedByUserId String
  status            String   @default("QUEUED")
  provider          String   @default("MOCK")
  errorMessage      String?
  inputs            Json?
  outputs           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
  @@index([productId])
  @@index([jobId])
  @@index([status])
}

model AiMediaUsageEvent {
  id                String   @id @default(cuid())
  organizationId    String
  productId         String?
  jobId             String?
  requestedByUserId String?
  action            String
  provider          String?
  status            String?
  units             Int      @default(1)
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([jobId])
  @@index([action])
}

model AiMediaRequest {
  id                 String                         @id @default(cuid())
  organizationId     String
  requestedByUserId  String
  targetType         AiMediaPlatformTargetType
  targetId           String?
  status             AiMediaPlatformRequestStatus   @default(DRAFT)
  privacyLevel       AiMediaPlatformPrivacyLevel    @default(ORGANIZATION)
  visibilityScope    AiMediaPlatformVisibilityScope @default(OWNER_ONLY)
  locale             String                         @default("fa")
  idempotencyKey     String
  payloadHash        String
  promptFingerprint  String?
  sourceFingerprints Json?
  requestPayload     Json?
  errorCode          String?
  errorMessage       String?
  submittedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User                @relation("AiMediaRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  jobMirrors   AiMediaJobMirror[]
  events       AiMediaJobEvent[]
  imports      AiMediaImport[]
  assets       AiMediaAsset[]
  usageQuotes  AiMediaUsageQuote[]
  spendHolds   AiMediaSpendHold[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, requestedByUserId, createdAt])
  @@index([targetType, targetId])
  @@index([requestedByUserId])
}

model AiMediaJobMirror {
  id                  String                  @id @default(cuid())
  requestId           String
  organizationId      String
  requestedByUserId   String
  state               AiMediaPlatformJobState @default(DRAFT)
  provider            String                  @default("MOCK")
  providerJobId       String?
  providerStatus      String?
  contractFingerprint String?
  correlationId       String
  idempotencyKey      String
  payloadHash         String
  statusPayload       Json?
  safeMetadata        Json?
  errorCode           String?
  errorMessage        String?
  submittedAt         DateTime?
  resultReadyAt       DateTime?
  importedAt          DateTime?
  failedAt            DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  request       AiMediaRequest             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy   User                       @relation("AiMediaJobRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  events        AiMediaJobEvent[]
  imports       AiMediaImport[]
  assets        AiMediaAsset[]
  spendHolds    AiMediaSpendHold[]
  contributions WorkerContributionMirror[]

  @@unique([organizationId, idempotencyKey])
  @@unique([correlationId])
  @@unique([provider, providerJobId])
  @@index([requestId])
  @@index([organizationId, state, createdAt])
  @@index([organizationId, requestedByUserId, createdAt])
  @@index([providerJobId])
  @@index([requestedByUserId])
}

model AiMediaJobEvent {
  id             String                   @id @default(cuid())
  organizationId String
  requestId      String?
  mirrorId       String?
  actorUserId    String?
  action         AiMediaJobEventAction
  state          AiMediaPlatformJobState?
  dedupeKey      String
  safeMetadata   Json?
  errorCode      String?
  createdAt      DateTime                 @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      AiMediaRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  mirror       AiMediaJobMirror? @relation(fields: [mirrorId], references: [id], onDelete: SetNull)
  actor        User?             @relation("AiMediaJobEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
  @@index([requestId])
  @@index([mirrorId])
  @@index([actorUserId])
  @@index([action])
}

model AiMediaImport {
  id                String                      @id @default(cuid())
  organizationId    String
  requestId         String
  mirrorId          String
  status            AiMediaPlatformImportStatus @default(NOT_REQUESTED)
  outputIndex       Int                         @default(0)
  resultFingerprint String?
  validationRisk    String?
  validationErrors  Json?
  acceptedAssetId   String?
  errorCode         String?
  errorMessage      String?
  plannedAt         DateTime                    @default(now())
  importedAt        DateTime?
  rolledBackAt      DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request       AiMediaRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  mirror        AiMediaJobMirror @relation(fields: [mirrorId], references: [id], onDelete: Cascade)
  acceptedAsset AiMediaAsset?    @relation("AiMediaImportAcceptedAsset", fields: [acceptedAssetId], references: [id], onDelete: SetNull)
  assets        AiMediaAsset[]

  @@unique([mirrorId, outputIndex])
  @@index([organizationId, status, createdAt])
  @@index([requestId])
  @@index([mirrorId])
  @@index([acceptedAssetId])
