  recommendations GrowthRecommendation[]

  @@unique([organizationId, keyword, intent])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, intent])
  @@index([organizationId, source])
  @@index([profileId])
  @@index([relatedEntityId])
}

model GrowthRecommendation {
  id                     String                     @id @default(cuid())
  publicId               String                     @unique @default(uuid())
  organizationId         String
  profileId              String?
  keywordClusterId       String?
  seoOpportunityId       String?
  businessEntityId       String?
  recommendationType     GrowthRecommendationType
  title                  String
  reason                 String                     @db.Text
  priority               SeoOpportunityPriority     @default(MEDIUM)
  status                 GrowthRecommendationStatus @default(PROPOSED)
