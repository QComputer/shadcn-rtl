// Prisma 6+ Schema for Multi-Tenant Multi-Locale Next.js Application
// Production-Ready version with all gaps filled
// TODO: Users can have several organization membership with "customer" role, but one with staff roles, e.g. "ADMIN", "MANAGER", "STAFF"
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---

enum OrganizationType {
  SHOP
  APPOINTMENT
}

enum OrganizationCapabilityKey {
  SHOP
  APPOINTMENT
}

enum OrganizationCapabilityStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationCollaborationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum OrganizationCollaborationDirection {
  ONE_WAY
  TWO_WAY
}

enum OrganizationCollaborationScopeKey {
  CUSTOMER_IDENTITY
  CUSTOMER_PROFILE
  ORDER_VISIBILITY
  LOYALTY
  COURIER
  EMPLOYEE_SCHEDULE
  CONTACT_INFORMATION
}

enum DomainType {
  PLATFORM_SUBDOMAIN
  CUSTOM
}

enum DomainKind {
  APEX
  SUBDOMAIN
}

enum DomainProvider {
  VERCEL
}

enum DomainStatus {
  REQUESTED
  PROVIDER_PENDING
  DNS_REQUIRED
  VERIFYING
  ACTIVE
  ERROR
  DISABLED
  REMOVAL_PENDING
  REMOVED
}

