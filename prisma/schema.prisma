// Prisma 6+ Schema for Multi-Tenant Multi-Locale Next.js Application
// Production-Ready version with all gaps filled
// TODO: Users can have several organization membership with "customer" role, but one with staff roles, e.g. "ADMIN", "MANAGER", "STAFF"
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum OrganizationType {
  SHOP
  APPOINTMENT
}

enum DomainType {
  PLATFORM_SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  DNS_REQUIRED
  VERIFYING
  ACTIVE
  FAILED
  DISABLED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  DRIVER
  CUSTOMER
  GUEST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderType {
  DELIVERY
  PICK_UP
}

enum OrderStatus {
  PENDING
  PLACED
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  DELIVERED
  RECEIVED
  CANCELLED
  REFUNDED
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  WALLET
  BANK_TRANSFER
}

enum InventoryMovementReason {
  INITIAL_STOCK
  MANUAL_ADJUSTMENT
  ORDER_CREATED
  ORDER_CANCELLED
  ORDER_REFUNDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  RESET_PASSWORD
  VERIFY_EMAIL
  ASSIGN_ROLE
  CHANGE_STATUS
}

enum ImageAccess {
  PUBLIC
  PRIVATE
}

enum CustomerClubMembershipStatus {
  ACTIVE
  PAUSED
  LEFT
  BLOCKED
}

enum CustomerClubTier {
  MEMBER
  LOYAL
  VIP
}

enum CustomerClubJoinSource {
  PUBLIC_SHOP
  CHECKOUT
  ADMIN_IMPORT
  CAMPAIGN
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELED
}

enum CampaignChannel {
  IN_APP
}

enum CampaignDeliveryStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}

enum LoyaltyLedgerType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
  REFUND
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PushPermissionState {
  PROMPT
  GRANTED
  DENIED
  UNSUPPORTED
  REVOKED
}

// --- CORE MODELS ---

model TimeInterval {
  id          String           @id @default(cuid())
  start       DateTime?
  end         DateTime?
  note        String?

  appointments Appointment[]
}

model Organization {
  id          String           @id @default(cuid())
  type        OrganizationType
  locale      String           @default("fa")
  timezone    String           @default("Asia/Tehran")
  name        String
  slug        String           @unique
  description String?          //@db.Text
  address     String?
  phone       String?
  email       String?
  logo        String?
  coverImage  String?
  lat         Float?
  lng         Float?
  isActive    Boolean          @default(true)
  isOpen      Boolean          @default(true)

  // Timestamps & Soft Delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  members           OrganizationMember[]
  businessHours     BusinessHour[]
  serviceCategories ServiceCategory[]
  services          Service[]
  productCategories ProductCategory[]
  products          Product[]
  carts             ShopCart[]
  orders            Order[]
  followers         Follow[]
  customerClubMemberships CustomerClubMembership[]
  customerSegments CustomerSegment[]
  customerSegmentSnapshots CustomerSegmentSnapshot[]
  campaigns         Campaign[]
  campaignDeliveries CampaignDelivery[]
  loyaltyLedgers    LoyaltyLedger[]
  loyaltyRules      LoyaltyRule[]
  coupons           Coupon[]
  couponRedemptions CouponRedemption[]
  pushSubscriptions PushSubscription[]
  notificationPermissionEvents NotificationPermissionEvent[]
  fanpagePosts      FanpagePost[]
  notifications     Notification[]
  locations         Location[]
  reviews           Review[]              @relation("OrgReviews")
  images            Image[]               @relation("OrganizationImages")
  settings          OrganizationSettings?
  bookingSettings   BookingSettings?
  promotions        Promotion[]
  auditLogs         AuditLog[]
  staffAvailability StaffAvailability[]
  bookingSessions   BookingSession[]
  domains           OrganizationDomain[]

  @@index([type])
  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
  @@index([id, slug])
  @@unique([id, slug])
  @@unique([id])
  @@index([id])
  paymentSettings PaymentSettings?
}


model OrganizationDomain {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  domain           String       @unique
  normalizedDomain String       @unique
  type             DomainType   @default(CUSTOM)
  status           DomainStatus @default(PENDING)
  isPrimary        Boolean      @default(false)

  vercelProjectDomainId String?
  verificationToken     String?
  verifiedAt            DateTime?
  lastCheckedAt         DateTime?
  failureReason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([isPrimary])
  @@index([organizationId, status])
}

model Deny {
  id           String   @id @default(cuid())
  orderId      String
  userId       String

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id])

  @@unique([orderId, userId])
}
model Notification {
  id           String   @id @default(cuid())
  targetUserId String
  context      String
  organizationId String?
  createdByUserId String?
  targetUser   User     @relation("TargetNotifications", fields: [targetUserId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation("CreatedNotifications", fields: [createdByUserId], references: [id], onDelete: SetNull)
  campaignDeliveries CampaignDelivery[]
  seen         Boolean  @default(false)
  type         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  readAt       DateTime?

  @@index([targetUserId])
  @@index([targetUserId, seen, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdByUserId])
}


model User {
  id           String   @id @default(cuid())
  password     String
  name         String   @unique
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  isTeamMember Boolean  @default(false)
  email        String?  @unique
  firstName    String?
  lastName     String?
  phone        String?
  avatar       String?
  image        String?
  address      String?
  status       String?

  // Email verification
  emailVerified DateTime?

  // User Preferences
  locale String @default("fa")
  theme  String @default("system")

  // Security
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Timestamps & Soft Delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  memberOf                 OrganizationMember[]
  providedServices         Service[]                 @relation("ServiceProviderRelation")
  appointments             Appointment[]             @relation("CustomerAppointmentRelation")
  carts                    ShopCart[]
  orders                   Order[]                   @relation("CustomerOrderRelation")
  assignedDeliveries       Order[]                   @relation("DriverOrderRelation")
  following                Follow[]
  customerClubMemberships  CustomerClubMembership[]
  fanpagePosts             FanpagePost[]
  sentMessages             Message[]                 @relation("SentMessages")
  receivedMessages         Message[]                 @relation("ReceivedMessages")
  locations                Location[]
  reviewsWritten           Review[]                  @relation("UserReviews")
  notifications             Notification[]            @relation("TargetNotifications")
  createdNotifications      Notification[]            @relation("CreatedNotifications")
  createdCampaigns          Campaign[]                @relation("CreatedCampaigns")
  campaignDeliveries        CampaignDelivery[]        @relation("CampaignTargetDeliveries")
  loyaltyLedgers            LoyaltyLedger[]           @relation("CustomerLoyaltyLedger")
  createdLoyaltyLedgers     LoyaltyLedger[]           @relation("CreatedLoyaltyLedger")
  couponRedemptions         CouponRedemption[]        @relation("CustomerCouponRedemptions")
  pushSubscriptions         PushSubscription[]        @relation("CustomerPushSubscriptions")
  notificationPermissionEvents NotificationPermissionEvent[] @relation("CustomerNotificationPermissionEvents")
  passwordResets           PasswordReset[]
  emailVerifications       EmailVerification[]
  auditLogs                AuditLog[]
  conversationParticipants ConversationParticipant[]
  businessHours BusinessHour[]
  uploadedImages Image[]                  @relation("UploadedImages")
  
  denies Deny[]


  @@index([email])
  @@index([name])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@index([emailVerified])
  orderMessages OrderMessage[]
}

model OrganizationMember {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole @default(STAFF)
  isActive       Boolean       @default(true)
  joinedAt       DateTime      @default(now())

  organizationSlug String

  organization Organization @relation(fields: [organizationId, organizationSlug], references: [id, slug])


  user         User                @relation(fields: [userId], references: [id])
  availability StaffAvailability[]

  @@unique([organizationId, userId])
  //@@index([organizationSlug, userId])
  @@index([organizationSlug])
  @@index([organizationId])
  @@index([userId])
}

model BusinessHour {
  id             String    @id @default(cuid())
  day            DayOfWeek
  openTime       String // Format "HH:mm"
  closeTime      String // Format "HH:mm"
  isOpen         Boolean   @default(true)

  userId String?
  user User? @relation(fields: [userId], references: [id])

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, day, userId])
  @@index([organizationId])
}


// --- AUTHENTICATION MODELS ---
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String    @unique
  token      String    @unique
  email      String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

// --- APPOINTMENT MODELS ---
model ServiceCategory {
  id             String  @id @default(cuid())
  name           String
  slug           String?
  description    String? //@db.Text
  image          String?
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  
  services     Service[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([organizationId, slug])
  @@index([deletedAt])
}

model Service {
  id          String  @id @default(cuid())
  name        String
  slug        String?
  description String? //@db.Text
  price       Decimal //@db.Decimal(12, 2)
  duration    Int // In minutes
  image       String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  organizationId    String
  categoryId        String
  serviceProviderId String?

  organization    Organization    @relation(fields: [organizationId], references: [id])
  category        ServiceCategory @relation(fields: [categoryId], references: [id])
  serviceProvider User?           @relation("ServiceProviderRelation", fields: [serviceProviderId], references: [id])
  appointments    Appointment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([organizationId, slug])
  @@index([categoryId])
  @@index([serviceProviderId])
  @@index([deletedAt])
}

model Appointment {
  id        String            @id @default(cuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(PENDING)
  notes     String?           //@db.Text

  timeInterval TimeInterval? @relation(fields: [timeIntervalid], references: [id])
  timeIntervalid String?

  // Cancellation details
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledBy        String?

  // Confirmation details
  confirmedAt DateTime?
  confirmedBy String?

  // Reminder tracking
  reminderSentAt DateTime?
  reminderSentBy String?
  followUpSentAt DateTime?
  followUpSentBy String?

  // Customer contact info at booking time (for guests)
  customerNameAtBooking  String?
  customerPhoneAtBooking String?
  customerEmailAtBooking String?

  // Booking reference for guest lookup
  bookingReference String? @unique

  customerId String?
  customer User?    @relation("CustomerAppointmentRelation", fields: [customerId], references: [id])
  guestCustomerId String?
  guestCustomer GuestCustomer?    @relation(fields: [guestCustomerId], references: [id])

  serviceId  String

  service  Service @relation(fields: [serviceId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([guestCustomerId])
  @@index([serviceId])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
  @@index([bookingReference])
}

// Staff availability for service providers
model StaffAvailability {
  id          String    @id @default(cuid())
  dayOfWeek   DayOfWeek
  startTime   String // Format "HH:mm"
  endTime     String // Format "HH:mm"
  isAvailable Boolean   @default(true)
  breakStart  String? // Format "HH:mm"
  breakEnd    String? // Format "HH:mm"

  // Specific date override (for vacations, special hours, etc.)
  specificDate DateTime?
  isDayOff     Boolean   @default(false)

  organizationId String
  staffId        String

  organization Organization       @relation(fields: [organizationId], references: [id])
  staff        OrganizationMember @relation(fields: [staffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, dayOfWeek, specificDate])
  @@index([organizationId])
  @@index([staffId])
  @@index([specificDate])
}

// Booking session for tracking booking attempts and analytics
model BookingSession {
  id             String    @id @default(cuid())
  sessionId      String    @unique
  organizationId String
  serviceId      String?
  selectedDate   DateTime?
  selectedTime   String?
  customerName   String?
  customerPhone  String?
  customerEmail  String?
  status         String    @default("started") // started, service_selected, datetime_selected, completed, abandoned
  completedAt    DateTime?
  abandonedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([organizationId])
  @@index([sessionId])
  @@index([status])
  @@index([expiresAt])
}

// --- SHOP MODELS ---

model ProductCategory {
  id             String  @id @default(cuid())
  name           String
  slug           String?
  description    String? //@db.Text
  image          String?
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)
  organizationId String
  organizationSlug String

  organization Organization @relation(fields: [organizationId, organizationSlug], references: [id,slug])
  products     Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([organizationSlug])
  @@index([organizationId, slug])
  @@index([deletedAt])
}

model Image {
  id          String       @id @default(cuid())
  url         String
  filename    String?
  mimeType    String?
  sizeBytes   Int?
  purpose     String       @default("upload")
  access      ImageAccess  @default(PUBLIC)

  uploadedByUserId String?
  organizationId   String?

  createdAt DateTime @default(now())

  uploadedBy   User?         @relation("UploadedImages", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation("OrganizationImages", fields: [organizationId], references: [id], onDelete: SetNull)
  products     Product[]

  @@index([uploadedByUserId])
  @@index([organizationId])
  @@index([purpose])
  @@index([access])
  @@index([createdAt])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String?
  description String?  //@db.Text
  basePrice   Decimal  //@db.Decimal(12, 2)

  image       String?
  images      Image[]
  sku         String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  // Inventory management
  
  trackInventory    Boolean @default(true)
  lowStockThreshold Int     @default(10)

  // Pricing / discount
  
  discountType    String?  @default("none") // "none" | "percentage" | "fixed"
  discountValue   Decimal? @default(0) //@db.Decimal(12, 2)

  organizationId String
  organizationSlug String
  categoryId     String

  organization Organization     @relation(fields: [organizationId, organizationSlug], references: [id,slug])
  category     ProductCategory  @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  orderItems   OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([organizationSlug])
  @@index([organizationId, slug])
  @@index([organizationSlug, slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([sku])
}

model ProductVariant {
  id        String   @id @default(cuid())
  sku       String?  @unique
  name      String? // e.g., "Large / Red"
  image     String?
  price     Decimal? //@db.Decimal(12, 2) // Override basePrice if set
  inventory Int      @default(0)

  // Stock management
  reservedQuantity Int     @default(0)
  allowBackOrder   Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItems      ShopCartItem[]
  orderItems     OrderItem[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId])
  @@index([deletedAt])
}

model ShopCart {
  id     String     @id @default(cuid())
  status CartStatus @default(ACTIVE)

  organizationSlug String
  organization Organization   @relation(fields: [organizationSlug], references: [slug])
  
  customerId     String?
  customer     User?           @relation(fields: [customerId], references: [id])
  
  sessionId   String?  

  expiresAt DateTime? // Cart expiration (e.g., 7 days)

  items        ShopCartItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@index([status])
  @@index([customerId])
  @@unique([organizationSlug, customerId])
  @@index([organizationSlug, customerId])
  @@index([sessionId])

  @@unique([organizationSlug, sessionId])
  @@index([organizationSlug, sessionId])
}

model ShopCartItem {
  id       String @id @default(cuid())
  quantity Int

  cartId    String
  variantId String

  cart    ShopCart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([variantId])
}


// Guest Customer 
model GuestCustomer {
  id      String  @id @default(cuid())
  name    String
  firstName    String?
  lastName     String?
  sessionId   String  @unique
  phone   String?
  email   String?
  address String?

  appointments Appointment[]
  orders Order[]

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([name])
  @@index([sessionId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  type        OrderType
  status      OrderStatus @default(PENDING)

  // Pricing
  subtotal    Decimal //@db.Decimal(12, 2)
  deliveryFee Decimal @default(0) //@db.Decimal(12, 2)
  tax         Decimal @default(0) //@db.Decimal(12, 2)
  discount    Decimal @default(0) //@db.Decimal(12, 2)
  total       Decimal //@db.Decimal(12, 2)

  // Delivery details
  deliveryAddress       String?
  deliveryLat           Decimal?
  deliveryLng           Decimal?
  estimatedDeliveryTime DateTime?
  deliveredAt           DateTime?

  // Notes
  notes String? //@db.Text

  // Payment
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String?

  // Public tracking
  publicTrackingToken String? @unique

  // Promotion
  promotionId   String?
  promotionCode String?

  // Metadata
  organizationSlug  String
  customerId      String?
  guestCustomerId String?
  driverId        String?

  organization   Organization   @relation(fields: [ organizationSlug], references: [slug])
  customer       User?          @relation("CustomerOrderRelation", fields: [customerId], references: [id])
  guestCustomer  GuestCustomer?    @relation(fields: [guestCustomerId], references: [id])
  assignedDriver User?          @relation("DriverOrderRelation", fields: [driverId], references: [id])
  items          OrderItem[]
  payment        Payment?
  paymentEvents  PaymentEvent[]
  statusHistory  OrderStatusHistory[]
  inventoryMovements InventoryMovement[]
  promotion      Promotion?     @relation(fields: [promotionId], references: [id])
  loyaltyLedgers LoyaltyLedger[]
  couponRedemptions CouponRedemption[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  preparationProgressId      String? @unique
  preparationProgress Progress? @relation("preparationProgressRelation", fields: [preparationProgressId], references: [id])
  
  pickupProgressId      String? @unique
  pickupProgress Progress? @relation("pickupProgressRelation", fields: [pickupProgressId], references: [id])
  
  deliveryProgressId      String? @unique
  deliveryProgress Progress? @relation("deliveryProgressRelation", fields: [deliveryProgressId], references: [id])

  denies Deny[]

  orderMessages OrderMessage[]

  @@index([organizationSlug])
  @@index([customerId])
  @@index([driverId])
  @@index([preparationProgressId])
  @@index([pickupProgressId])
  @@index([deliveryProgressId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([orderNumber])
  @@index([publicTrackingToken])
  @@index([promotionId])
}


model Progress{
  id         String    @id @default(cuid())
  startTime DateTime?
  endTime   DateTime?
  estimatedEndTime DateTime?
  remMinutes  Float?
  percentage Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  preparationProgress Order? @relation("preparationProgressRelation")
  pickupProgress Order? @relation("pickupProgressRelation")
  deliveryProgress Order? @relation("deliveryProgressRelation")
}

model OrderItem {
  id       String  @id @default(cuid())
  quantity Int
  price    Decimal //@db.Decimal(12, 2)

  // Optional discount per item
  discount Decimal @default(0) //@db.Decimal(12, 2)

  orderId   String
  productId String
  variantId String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model InventoryMovement {
  id             String                  @id @default(cuid())
  variantId      String
  orderId        String?
  quantityDelta  Int
  quantityBefore Int?
  quantityAfter  Int?
  reason         InventoryMovementReason
  note           String?
  createdById    String?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([orderId])
  @@index([reason])
  @@index([createdAt])
  @@index([createdById])
}

model Payment {
  id            String        @id @default(cuid())
  amount        Decimal       //@db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  metadata      Json?

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
}


model PaymentEvent {
  id             String         @id @default(cuid())
  orderId        String
  previousStatus PaymentStatus?
  newStatus      PaymentStatus
  method         PaymentMethod?
  amount         Decimal?
  transactionId  String?
  note           String?
  createdById    String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([newStatus])
  @@index([createdAt])
  @@index([createdById])
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String
  previousStatus OrderStatus?
  newStatus      OrderStatus
  note           String?
  changedById    String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([newStatus])
  @@index([createdAt])
  @@index([changedById])
}

model Promotion {
  id             String   @id @default(cuid())
  code           String   @unique
  description    String?
  discountType   String // "percentage" | "fixed"
  discountValue  Decimal  //@db.Decimal(12, 2)
  minOrderAmount Decimal? //@db.Decimal(12, 2)
  maxUses        Int?
  usedCount      Int      @default(0)
  startsAt       DateTime
  expiresAt      DateTime
  isActive       Boolean  @default(true)

  organizationSlug String
  organization   Organization @relation(fields: [organizationSlug], references: [slug])

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationSlug])
  @@index([code])
  @@index([expiresAt])
  @@index([isActive])
}

// --- SOCIAL & FEEDBACK ---

model Review {
  id      String  @id @default(cuid())
  rating  Int     @default(5)
  comment String? //@db.Text

  // Review metadata
  isVerifiedPurchase Boolean @default(false)

  userId         String
  organizationSlug String

  user         User         @relation("UserReviews", fields: [userId], references: [id])
  organization Organization @relation("OrgReviews", fields: [organizationSlug], references: [slug])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationSlug]) // One review per user per org
  @@index([organizationSlug])
  @@index([rating])
}

model FanpagePost {
  id             String   @id @default(cuid())
  organizationId String
  authorId       String
  title          String?
  body           String   @db.Text
  image          String?
  video          String?
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([organizationId, isPublished, deletedAt, createdAt])
  @@index([authorId])
}

model Follow {
  id             String   @id @default(cuid())
  customerId     String
  organizationId String
  createdAt      DateTime @default(now())

  customer     User         @relation(fields: [customerId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([customerId, organizationId])
  @@index([organizationId])
}

model CustomerClubMembership {
  id             String                       @id @default(cuid())
  organizationId String
  customerId     String
  status         CustomerClubMembershipStatus @default(ACTIVE)
  tier           CustomerClubTier             @default(MEMBER)
  source         CustomerClubJoinSource       @default(PUBLIC_SHOP)
  joinedAt       DateTime                     @default(now())
  leftAt         DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     User         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, customerId])
  @@index([organizationId, status])
  @@index([customerId, status])
}

model CustomerSegment {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  name           String
  description    String?
  rule           Json?
  isSystem       Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules        CustomerSegmentRule[]
  snapshots    CustomerSegmentSnapshot[]
  campaignAudiences CampaignAudience[]

  @@unique([organizationId, key])
  @@index([organizationId, isActive])
}

model CustomerSegmentRule {
  id        String   @id @default(cuid())
  segmentId String
  field     String
  operator  String
  value     Json?
  createdAt DateTime @default(now())

  segment CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([segmentId])
}

model CustomerSegmentSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  segmentId      String?
  segmentKey     String
  memberCount    Int
  rule           Json?
  calculatedAt   DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  segment      CustomerSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  campaignAudiences CampaignAudience[]

  @@index([organizationId, segmentKey, calculatedAt])
  @@index([segmentId, calculatedAt])
}

model Campaign {
  id              String         @id @default(cuid())
  organizationId  String
  createdByUserId String?
  title           String
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  canceledAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CreatedCampaigns", fields: [createdByUserId], references: [id], onDelete: SetNull)
  audiences    CampaignAudience[]
  messages     CampaignMessage[]
  deliveries   CampaignDelivery[]

  @@index([organizationId, status, createdAt])
  @@index([createdByUserId])
}

model CampaignAudience {
  id                String   @id @default(cuid())
  campaignId        String
  segmentId         String?
  segmentSnapshotId String?
  segmentKey        String
  memberCount       Int      @default(0)
  rule              Json?
  createdAt         DateTime @default(now())

  campaign        Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  segment         CustomerSegment?         @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  segmentSnapshot CustomerSegmentSnapshot? @relation(fields: [segmentSnapshotId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([segmentId])
  @@index([segmentSnapshotId])
  @@index([segmentKey])
}

model CampaignMessage {
  id         String          @id @default(cuid())
  campaignId String
  channel    CampaignChannel @default(IN_APP)
  body       String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  campaign   Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliveries CampaignDelivery[]

  @@index([campaignId, channel])
}

model CampaignDelivery {
  id             String                 @id @default(cuid())
  campaignId     String
  messageId      String?
  organizationId String
  targetUserId   String
  notificationId String?
  channel        CampaignChannel        @default(IN_APP)
  status         CampaignDeliveryStatus @default(PENDING)
  error          String?
  sentAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  campaign     Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  message      CampaignMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetUser   User             @relation("CampaignTargetDeliveries", fields: [targetUserId], references: [id], onDelete: Cascade)
  notification Notification?    @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@unique([campaignId, targetUserId, channel])
  @@index([organizationId, status, createdAt])
  @@index([messageId])
  @@index([notificationId])
  @@index([targetUserId])
}

model LoyaltyLedger {
  id              String            @id @default(cuid())
  organizationId  String
  customerId      String
  orderId         String?
  type            LoyaltyLedgerType
  points          Int
  reason          String?
  metadata        Json?
  createdByUserId String?
  createdAt       DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     User         @relation("CustomerLoyaltyLedger", fields: [customerId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("CreatedLoyaltyLedger", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, orderId, type])
  @@index([organizationId, customerId, createdAt])
  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([createdByUserId])
}

model LoyaltyRule {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  spendAmount     Decimal  @default(100000)
  pointsAwarded   Int      @default(1)
  pointsPerOrder  Int      @default(0)
  minOrderTotal   Decimal  @default(0)
  isActive        Boolean  @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@index([organizationId, createdAt])
}

model Coupon {
  id                String             @id @default(cuid())
  organizationId    String
  code              String
  name              String
  description       String?
  discountType      CouponDiscountType
  discountValue     Decimal
  minOrderTotal     Decimal?
  maxDiscountAmount Decimal?
  startsAt          DateTime?
  expiresAt         DateTime?
  usageLimit        Int?
  usedCount         Int                @default(0)
  perCustomerLimit  Int?
  segmentKey        String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  redemptions  CouponRedemption[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([organizationId, segmentKey])
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  organizationId String
  customerId     String
  orderId        String?
  discountAmount Decimal  @default(0)
  pointsSpent    Int      @default(0)
  metadata       Json?
  redeemedAt     DateTime @default(now())

  coupon       Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     User         @relation("CustomerCouponRedemptions", fields: [customerId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([couponId, orderId])
  @@index([organizationId, customerId, redeemedAt])
  @@index([couponId, redeemedAt])
  @@index([orderId])
}

model PushSubscription {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  endpoint       String
  p256dh         String
  auth           String
  userAgent      String?
  isActive       Boolean  @default(true)
  lastSeenAt     DateTime @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         User                          @relation("CustomerPushSubscriptions", fields: [customerId], references: [id], onDelete: Cascade)
  permissionEvents NotificationPermissionEvent[]

  @@unique([organizationId, customerId, endpoint])
  @@index([organizationId, customerId, isActive])
  @@index([customerId, isActive])
  @@index([endpoint])
}

model NotificationPermissionEvent {
  id             String              @id @default(cuid())
  organizationId String
  customerId     String
  subscriptionId String?
  state          PushPermissionState
  source         String              @default("PUBLIC_SHOP")
  reason         String?
  userAgent      String?
  createdAt      DateTime            @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     User              @relation("CustomerNotificationPermissionEvents", fields: [customerId], references: [id], onDelete: Cascade)
  subscription PushSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId, createdAt])
  @@index([subscriptionId])
  @@index([state, createdAt])
}

model Conversation {
  id            String    @id @default(cuid())
  type          String    @default("direct") // "direct" | "group"
  name          String? // For group chats
  lastMessage   String?   @db.Text
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  orderMessages     OrderMessage[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  role           String   @default("member") // "member" | "admin"
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id      String    @id @default(cuid())
  content String    @db.Text
  isRead  Boolean   @default(false)
  readAt  DateTime?

  senderId       String
  receiverId     String
  conversationId String

  sender       User         @relation("SentMessages", fields: [senderId], references: [id])
  receiver     User         @relation("ReceivedMessages", fields: [receiverId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}


model OrderMessage {
  id      String    @id @default(cuid())
  content String    @db.Text
  isRead  Boolean   @default(false)
  readAt  DateTime?

  senderId       String
  orderNumber     String
  conversationId String

  sender       User         @relation(fields: [senderId], references: [id])
  receiver     Order        @relation(fields: [orderNumber], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  createdAt DateTime @default(now())
  persist Boolean?  @default(true)

  @@index([conversationId])
  @@index([senderId])
  @@index([orderNumber])
  @@index([createdAt])
}

model Location {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())
  accuracy  Float?
  altitude  Float?
  speed     Float?

  userId         String
  organizationId String?

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([timestamp])
}

// --- SETTINGS & CONFIGURATION ---

model OrganizationSettings {
  id             String @id @default(cuid())
  organizationSlug String @unique

  // General settings
  settings   Json? // Flexible configuration store
  currency   String? @default("IRR")
  dateFormat String @default("YYYY-MM-DD")
  timeFormat String @default("24h")

  // Business settings
  minimumOrderAmount Decimal? //@db.Decimal(12, 2)
  maximumOrderAmount Decimal? //@db.Decimal(12, 2)
  deliveryRadius     Float?
  deliveryFee        Float? @default(50000)
  enablePickup       Boolean  @default(true)
  enableDelivery     Boolean  @default(true)

  // Notification settings
  emailNotifications Boolean @default(false)
  smsNotifications   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationSlug], references: [slug])

  @@index([organizationSlug])
}

model PaymentSettings {
  id             String @id @default(cuid())
  organizationSlug String @unique
  cardOwnerName String?

  // General settings
  settings   Json? // Flexible configuration store
  
  paymentCondition  Boolean? @default(false)
  paymentMethodInt Int? @default(0)
  cardNumber String?

  organization Organization @relation(fields: [organizationSlug], references: [slug])

  @@index([organizationSlug])
}

// Booking Settings for appointment-based organizations
model BookingSettings {
  id             String @id @default(cuid())
  organizationSlug String @unique

  // Slot configuration
  slotDuration Int @default(30) // minutes
  bufferBefore Int @default(0) // minutes before appointment
  bufferAfter  Int @default(0) // minutes after appointment

  // Booking rules
  minBookingNotice      Int     @default(60) // minutes before appointment
  maxBookingAdvance     Int     @default(43200) // minutes (30 days default)
  maxAppointmentsPerDay Int?
  allowCancellation     Boolean @default(true)
  cancellationDeadline  Int     @default(1440) // minutes before (24h default)

  // Customer info requirements
  requirePhone Boolean @default(true)
  requireEmail Boolean @default(false)
  requireName  Boolean @default(true)

  // Auto-confirmation
  autoConfirm Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationSlug], references: [slug])

  @@index([organizationSlug])
}

// --- AUDIT & LOGGING ---

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String // e.g., "Order", "User", "Organization"
  entityId    String
  description String?

  // Before/after values
  previousValue Json?
  newValue      Json?

  // Request metadata
  ipAddress String?
  userAgent String?

  // User info
  userId         String?
  organizationId String?
  organizationSlug String?

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId, organizationSlug], references: [id, slug])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([organizationId])
  @@index([organizationSlug])
  @@index([action])
  @@index([createdAt])
}
