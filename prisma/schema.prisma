  organizationId String?

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([timestamp])
}

// --- SETTINGS & CONFIGURATION ---

model OrganizationSettings {
  id               String @id @default(cuid())
  organizationSlug String @unique

  // General settings
  settings   Json? // Flexible configuration store
  currency   String? @default("IRR")
  dateFormat String  @default("YYYY-MM-DD")
  timeFormat String  @default("24h")

  // Business settings
  minimumOrderAmount        Decimal? //@db.Decimal(12, 2)
  maximumOrderAmount        Decimal? //@db.Decimal(12, 2)
  deliveryRadius            Float?
  deliveryFee               Float?   @default(50000)
  enablePickup              Boolean  @default(true)
  enableDelivery            Boolean  @default(true)
  defaultPreparationMinutes Int      @default(30)

  // Notification settings
  emailNotifications Boolean @default(false)
  smsNotifications   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationSlug], references: [slug])

  @@index([organizationSlug])
}

model PaymentSettings {
  id               String  @id @default(cuid())
  organizationSlug String  @unique
  cardOwnerName    String?

  // General settings
  settings Json? // Flexible configuration store

  paymentCondition Boolean? @default(false)
  paymentMethodInt Int?     @default(0)
  cardNumber       String?

  organization Organization @relation(fields: [organizationSlug], references: [slug])

  @@index([organizationSlug])
}

// Booking Settings for appointment-based organizations
model BookingSettings {
  id               String @id @default(cuid())
  organizationSlug String @unique

  // Slot configuration
  slotDuration Int @default(30) // minutes
  bufferBefore Int @default(0) // minutes before appointment
  bufferAfter  Int @default(0) // minutes after appointment

  // Booking rules
  minBookingNotice      Int     @default(60) // minutes before appointment
  maxBookingAdvance     Int     @default(43200) // minutes (30 days default)
  maxAppointmentsPerDay Int?
  allowCancellation     Boolean @default(true)
  cancellationDeadline  Int     @default(1440) // minutes before (24h default)

  // Customer info requirements
  requirePhone Boolean @default(true)
  requireEmail Boolean @default(false)
  requireName  Boolean @default(true)

  // Auto-confirmation
  autoConfirm Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationSlug], references: [slug])

  @@index([organizationSlug])
}

// --- AUDIT & LOGGING ---

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String // e.g., "Order", "User", "Organization"
  entityId    String
  description String?

  // Before/after values
  previousValue Json?
  newValue      Json?

  // Request metadata
  ipAddress String?
  userAgent String?

  // User info
  userId           String?
  organizationId   String?
  organizationSlug String?

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId, organizationSlug], references: [id, slug])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([organizationId])
  @@index([organizationSlug])
  @@index([action])
  @@index([createdAt])
}

model RequestDemoLead {
  id     String                @id @default(cuid())
  status RequestDemoLeadStatus @default(NEW)
  source String?               @default("request-demo")
  locale String                @default("fa")

  // Contact info
  fullName     String  @db.Text
  businessName String  @db.Text
  businessType String  @db.Text
  phone        String
  city         String? @db.Text

  // Preferences
  preferredContactTime String? @db.Text
  needSummary          String? @db.Text

  // Consent
  consentAccepted Boolean @default(false)

  // Abuse / metadata
  ipHash        String?
  userAgentHash String?

  // Review
  reviewedAt              DateTime?
  reviewedById            String?
  reviewedBy              User?                    @relation("LeadReviewerRelation", fields: [reviewedById], references: [id], onDelete: SetNull)
  adminNote               String?                  @db.Text
  tenantProvisioningPlans TenantProvisioningPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([source])
  @@index([createdAt])
  @@index([reviewedById])
}

model TenantProvisioningPlan {
  id                String                       @id @default(cuid())
  requestDemoLeadId String?
  sourceType        TenantProvisioningSourceType
  sourceReference   String?

  status         TenantProvisioningPlanStatus @default(DRAFT)
  idempotencyKey String                       @unique

  proposedOrganizationType OrganizationType
  proposedName             String
  proposedSlug             String
  proposedDefaultLocale    String           @default("fa")
  proposedTimezone         String           @default("Asia/Tehran")
  proposedCurrency         String?

  proposedOwnerName  String?
  proposedOwnerPhone String?
  proposedOwnerEmail String?

  proposedPackageId    String?
  proposedModules      Json?
  proposedFeatureFlags Json?
  proposedSettings     Json?
  proposedDemoContent  Boolean @default(false)
  proposedCustomDomain String?

  validationVersion Int       @default(0)
  validationResult  Json?
  validationErrors  Json?
  validatedAt       DateTime?
  readyAt           DateTime?
  approvedAt        DateTime?
  cancelledAt       DateTime?

  createdById  String
  updatedById  String?
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestDemoLead RequestDemoLead? @relation(fields: [requestDemoLeadId], references: [id], onDelete: SetNull)
  createdBy       User             @relation("TenantProvisioningPlanCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?            @relation("TenantProvisioningPlanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedBy      User?            @relation("TenantProvisioningPlanApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([requestDemoLeadId, sourceType])
  @@index([requestDemoLeadId])
  @@index([sourceType, sourceReference])
  @@index([status, createdAt])
  @@index([proposedSlug])
  @@index([createdAt])
}
