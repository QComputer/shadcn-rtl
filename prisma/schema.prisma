  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        BusinessGrowthProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  keywordCluster KeywordCluster?        @relation(fields: [keywordClusterId, organizationId], references: [id, organizationId], onDelete: Cascade)
  seoOpportunity SeoOpportunity?        @relation(fields: [seoOpportunityId, organizationId], references: [id, organizationId], onDelete: Cascade)
