enum TenantProvisioningSourceType {
  REQUEST_DEMO_LEAD
  ONBOARDING_WIZARD
  MANUAL
}

enum CreativeStudioTargetType {
  PRODUCT
  CAMPAIGN
  FANPAGE_POST
  ORGANIZATION_BRAND
  IMPORTED_MEDIA
}

enum CreativeStudioAssetType {
  PRODUCT_IMAGE
  CAMPAIGN_IMAGE
  FANPAGE_IMAGE
  LOGO
  COVER
  OG_IMAGE
  IMPORT_MEDIA
}

enum CreativeStudioJobStatus {
