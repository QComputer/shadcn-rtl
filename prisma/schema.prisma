// --- CORE MODELS ---

model TimeInterval {
  id    String    @id @default(cuid())
  start DateTime?
  end   DateTime?
  note  String?

  appointments Appointment[]
}

model Organization {
  id                        String           @id @default(cuid())
  type                      OrganizationType
  locale                    String           @default("fa")
  timezone                  String           @default("Asia/Tehran")
  name                      String
  slug                      String           @unique
  description               String? //@db.Text
  address                   String?
  phone                     String?
  email                     String?
  logo                      String?
  coverImage                String?
  lat                       Float?
  lng                       Float?
  isActive                  Boolean          @default(true)
  isOpen                    Boolean          @default(true)
  capabilitiesInitializedAt DateTime?

  // Timestamps & Soft Delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  members                      OrganizationMember[]
  acquisition                  OrganizationAcquisition?
  activationPlan               OrganizationActivationPlan?
  activationTasks              OrganizationActivationTask[]
  pilotWorkspace               PilotWorkspace?
  invitations                  OrganizationInvitation[]
  claimRequests                OrganizationClaimRequest[]
  capabilities                 OrganizationCapability[]
  integrations                 OrganizationIntegration[]
  businessEvents               BusinessEvent[]
  customerIdentities           CustomerIdentity[]
  customerInteractions         CustomerInteraction[]
  reviewRequests               ReviewRequest[]
  reputationReviews            Review[]                       @relation("OrganizationReputationReviews")
  demoSessionTokens            DemoSessionToken[]
  demoScenarios                DemoScenario[]
  demoProgressEntries          DemoProgress[]
  externalCatalogConnections   ExternalCatalogConnection[]
  externalImportRuns           ExternalImportRun[]
  externalEntityMappings       ExternalEntityMapping[]
  externalCatalogSyncJobs      ExternalCatalogSyncJob[]
  businessEntities             BusinessEntity[]
  businessEntityRelations      BusinessEntityRelation[]
  businessEntityMetadataEntries BusinessEntityMetadata[]
  businessGrowthProfile        BusinessGrowthProfile?
  keywordClusters              KeywordCluster[]
  growthRecommendations        GrowthRecommendation[]
  seoOpportunities             SeoOpportunity[]
  seoContentRequests           SeoContentRequest[]
  seoContentBriefs             SeoContentBrief[]
  contentAssets                ContentAsset[]
  contentDistributions         ContentDistribution[]
  socialConnections            SocialConnection[]
  socialPosts                  SocialPost[]
  ussdSessions                 UssdSession[]
  ussdPaymentIntents           UssdPaymentIntent[]
  ussdCallbackEvents           UssdCallbackEvent[]
  ownedCollaborations          OrganizationCollaboration[]   @relation("CollaborationOwner")
  partnerCollaborations        OrganizationCollaboration[]   @relation("CollaborationPartner")
  readyTimeHistory             OrderReadyTimeHistory[]
  businessHours                BusinessHour[]
  serviceCategories            ServiceCategory[]
  services                     Service[]
  productCategories            ProductCategory[]
  products                     Product[]
  carts                        ShopCart[]
  orders                       Order[]
  followers                    Follow[]
  customerClubMemberships      CustomerClubMembership[]
  customerSegments             CustomerSegment[]
  customerSegmentSnapshots     CustomerSegmentSnapshot[]
  campaigns                    Campaign[]
  campaignDeliveries           CampaignDelivery[]
  loyaltyLedgers               LoyaltyLedger[]
  loyaltyRules                 LoyaltyRule[]
  coupons                      Coupon[]
  couponRedemptions            CouponRedemption[]
  pushSubscriptions            PushSubscription[]
  notificationPermissionEvents NotificationPermissionEvent[]
  notificationPreferences      NotificationPreference[]
  webPushDeliveries            WebPushDelivery[]
  smsDeliveries                SmsDelivery[]
  fanpagePosts                 FanpagePost[]
  notifications                Notification[]
  locations                    Location[]
  reviews                      Review[]                      @relation("OrgReviews")
  images                       Image[]                       @relation("OrganizationImages")
  settings                     OrganizationSettings?
  bookingSettings              BookingSettings?
  promotions                   Promotion[]
  auditLogs                    AuditLog[]
  staffAvailability            StaffAvailability[]
  bookingSessions              BookingSession[]
  domains                      OrganizationDomain[]
  externalImportSources        ExternalImportSource[]
  externalImportJobs           ExternalImportJob[]
  importedProductDrafts        ImportedProductDraft[]
  importedContentDrafts        ImportedContentDraft[]
  exportJobs                   ExportJob[]
  aiMediaRequests              AiMediaRequest[]
  aiMediaJobMirrors            AiMediaJobMirror[]
  aiMediaJobEvents             AiMediaJobEvent[]
  aiMediaImports               AiMediaImport[]
  aiMediaAssets                AiMediaAsset[]
  aiMediaUsageQuotes           AiMediaUsageQuote[]
  aiMediaSpendHolds            AiMediaSpendHold[]
  workerContributionMirrors    WorkerContributionMirror[]
  paymentSettings              PaymentSettings?

  @@unique([id, slug])
  @@unique([id])
  @@index([type])
  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
  @@index([id, slug])
  @@index([id])
}

model OrganizationAcquisition {
  id              String                            @id @default(cuid())
  organizationId  String                            @unique
  sourceType      OrganizationAcquisitionSourceType
  industryKey     OrganizationIndustryKey
  createdByUserId String?
  agentUserId     String?
  metadata        Json?
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("OrganizationAcquisitionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  agentUser     User?        @relation("OrganizationAcquisitionAgent", fields: [agentUserId], references: [id], onDelete: SetNull)

  @@index([sourceType, createdAt])
  @@index([industryKey])
  @@index([createdByUserId])
  @@index([agentUserId])
}

model OrganizationActivationPlan {
  id                     String                           @id @default(cuid())
  organizationId         String                           @unique
  industryKey            OrganizationIndustryKey
  status                 OrganizationActivationPlanStatus @default(ACTIVE)
  generatedFromTemplate  String
  recommendedActions     Json
  completedActions       Json                             @default("[]")
  growthOpportunities    Json
  ownerOnboardingReadModel Json
  metadata               Json?
  generatedAt            DateTime                         @default(now())
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        OrganizationActivationTask[]

  @@index([industryKey, status])
  @@index([status, updatedAt])
}

model OrganizationActivationTask {
  id               String                             @id @default(cuid())
  organizationId   String
  activationPlanId String
  taskKey          String
  title            String
  description      String?                            @db.Text
  category         OrganizationActivationTaskCategory
  status           OrganizationActivationTaskStatus   @default(PENDING)
  completedAt      DateTime?
  targetRoute      String?
  metadata         Json?
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime                           @updatedAt

  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activationPlan OrganizationActivationPlan @relation(fields: [activationPlanId], references: [id], onDelete: Cascade)

  @@unique([organizationId, taskKey])
  @@index([activationPlanId, status])
  @@index([organizationId, status])
  @@index([organizationId, category, status])
}

model PilotWorkspace {
  id                  String               @id @default(cuid())
  organizationId      String               @unique
  status              PilotWorkspaceStatus @default(DISCOVERY)
  assignedOperatorId  String?
  notes               String?              @db.Text
  checklist           Json                 @default("[]")
  completedChecklist  Json                 @default("[]")
  readinessSummary    Json
  seoGrowthPlanner    Json?
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedOperator User?        @relation("PilotWorkspaceAssignedOperator", fields: [assignedOperatorId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([assignedOperatorId])
}

model OrganizationInvitation {
  id              String                       @id @default(cuid())
  publicId        String                       @unique @default(uuid())
  organizationId  String
  invitedRole     UserRole
  tokenHash       String                       @unique
  expiresAt       DateTime
  status          OrganizationInvitationStatus @default(CREATED)
  createdByUserId String?
  claimedByUserId String?
  metadata        Json?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

