  PRIVATE
}

enum CustomerClubMembershipStatus {
  ACTIVE
  PAUSED
  LEFT
  BLOCKED
}

enum CustomerClubTier {
  MEMBER
  LOYAL
  VIP
}

enum CustomerClubJoinSource {
  PUBLIC_SHOP
  CHECKOUT
  ADMIN_IMPORT
  CAMPAIGN
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELED
}

enum CampaignChannel {
  IN_APP
}

enum NotificationChannel {
  IN_APP
  WEB_PUSH
  SMS
  EMAIL
}

enum CampaignDeliveryStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}

enum LoyaltyLedgerType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
  REFUND
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PushPermissionState {
  PROMPT
  GRANTED
  DENIED
  UNSUPPORTED
  REVOKED
}

enum WebPushDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum SmsDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationDeliveryAttemptStatus {
  QUEUED
  SENT
  DRY_RUN
  SKIPPED
  FAILED
  RETRY_SCHEDULED
  RETRY_EXHAUSTED
}

model NotificationDeliveryAttempt {
  id              String  @id @default(cuid())
  organizationId  String
  targetUserId    String?
  orderId         String?
  guestCustomerId String?
  notificationId  String?

  channel           String
  purpose           String
  status            NotificationDeliveryAttemptStatus @default(QUEUED)
  dryRun            Boolean                           @default(false)
  retryable         Boolean                           @default(false)
  retryCount        Int                               @default(0)
  nextRetryAt       DateTime?
  lastErrorCode     String?
  lastErrorText     String?
  providerMessageId String?
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([targetUserId])
  @@index([orderId])
  @@index([guestCustomerId])
  @@index([notificationId])
}

