model ExternalCatalogConnection {
  id             String                          @id @default(cuid())
  publicId       String                          @unique @default(uuid())
  organizationId String
  provider       ExternalCatalogProvider
  externalUrl    String?
  status         ExternalCatalogConnectionStatus @default(DRAFT)
  syncMode       ExternalCatalogSyncMode         @default(PREVIEW_ONLY)
  metadata       Json?
  lastSyncAt     DateTime?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ExternalCatalogItem[]
  syncRuns     CatalogSyncRun[]
  importRuns   ExternalImportRun[]
  mappings     ExternalEntityMapping[]
  syncJobs     ExternalCatalogSyncJob[]

  @@unique([organizationId, provider, externalUrl])
  @@index([organizationId, status])
  @@index([provider, status])
}

model ExternalCatalogItem {
  id             String                       @id @default(cuid())
  publicId       String                       @unique @default(uuid())
  connectionId   String
  organizationId String
  externalId     String
  externalType   ExternalCatalogItemType
  rawName        String
  normalizedName String?
  status         ExternalCatalogItemStatus    @default(DISCOVERED)
  mappingStatus  ExternalCatalogMappingStatus @default(UNMAPPED)
  approvedAt     DateTime?
  rejectedAt     DateTime?
  importedAt     DateTime?
  importedEntityType InternalBusinessEntityType?
  importedEntityId   String?
  rawPayload      Json?
  previewPayload  Json?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  connection ExternalCatalogConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  mappings   ExternalEntityMapping[]

  @@unique([connectionId, externalId, externalType])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, mappingStatus])
  @@index([connectionId, mappingStatus])
}

model CatalogSyncRun {
  id             String               @id @default(cuid())
  publicId       String               @unique @default(uuid())
  connectionId   String
  organizationId String
  status         CatalogSyncRunStatus @default(QUEUED)
  startedAt      DateTime             @default(now())
  finishedAt     DateTime?
  changesSummary Json?
  metadata       Json?

  connection ExternalCatalogConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@index([connectionId, startedAt])
  @@index([status, startedAt])
}

model ExternalImportRun {
  id             String                  @id @default(cuid())
  publicId       String                  @unique @default(uuid())
  organizationId String
  connectionId   String
  status         ExternalImportRunStatus @default(PREVIEW)
  summary        Json?
  errorMessage   String?
  startedAt      DateTime                @default(now())
  finishedAt     DateTime?
  approvedAt     DateTime?
  importedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   ExternalCatalogConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([connectionId, startedAt])
}

model ExternalEntityMapping {
  id                 String                      @id @default(cuid())
  publicId           String                      @unique @default(uuid())
  organizationId     String
  connectionId       String?
  externalItemId     String?
  externalSource     String
  externalEntityType ExternalEntityType
  externalId         String
  internalEntityType InternalBusinessEntityType
  internalEntityId   String?
  confidenceScore    Decimal?                    @db.Decimal(5, 4)
  status             ExternalEntityMappingStatus @default(SUGGESTED)
  metadata           Json?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   ExternalCatalogConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalItem ExternalCatalogItem?       @relation(fields: [externalItemId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, externalSource, externalEntityType, externalId, internalEntityType])
  @@index([organizationId, status])
  @@index([connectionId, status])
  @@index([externalItemId])
  @@index([internalEntityType, internalEntityId])
}

model ExternalCatalogSyncJob {
  id             String                       @id @default(cuid())
  publicId       String                       @unique @default(uuid())
  organizationId String
  connectionId   String?
  source         String
  entityType     ExternalEntityType
  status         ExternalCatalogSyncJobStatus @default(QUEUED)
  startedAt      DateTime                     @default(now())
  finishedAt     DateTime?
  resultSummary  Json?
  errorMessage   String?
  dryRun         Boolean                      @default(true)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   ExternalCatalogConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([connectionId, startedAt])
  @@index([source, entityType])
}

model BusinessEntity {
  id             String                     @id @default(cuid())
  publicId       String                     @unique @default(uuid())
  organizationId String
  entityType     InternalBusinessEntityType
  entityId       String
  title          String
  slug           String?
  status         BusinessEntityStatus       @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outgoingRelations BusinessEntityRelation[] @relation("BusinessEntityRelationSource")
  incomingRelations BusinessEntityRelation[] @relation("BusinessEntityRelationTarget")
  metadataEntries   BusinessEntityMetadata[]
  seoOpportunities  SeoOpportunity[]
  seoContentRequests SeoContentRequest[]
  seoContentBriefs   SeoContentBrief[]
  contentAssets      ContentAsset[]
  socialPosts       SocialPost[]
  reviews           Review[]
  keywordClusters   KeywordCluster[]
  growthRecommendations GrowthRecommendation[]

  @@unique([organizationId, entityType, entityId])
  @@unique([id, organizationId])
  @@index([organizationId, entityType])
  @@index([organizationId, status])
  @@index([slug])
}

model BusinessEntityRelation {
  id             String                     @id @default(cuid())
  publicId       String                     @unique @default(uuid())
  organizationId String
  sourceEntityId String
  targetEntityId String
  relationType   BusinessEntityRelationType
  metadata       Json?
  createdAt      DateTime                   @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceEntity BusinessEntity @relation("BusinessEntityRelationSource", fields: [sourceEntityId, organizationId], references: [id, organizationId], onDelete: Cascade)
  targetEntity BusinessEntity @relation("BusinessEntityRelationTarget", fields: [targetEntityId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, sourceEntityId, targetEntityId, relationType])
  @@index([organizationId, sourceEntityId])
  @@index([organizationId, targetEntityId])
  @@index([organizationId, relationType])
}

model BusinessEntityMetadata {
  id             String   @id @default(cuid())
  publicId       String   @unique @default(uuid())
  organizationId String
  entityId       String
  seoTitle       String?
  seoDescription String?
  schemaType     String?
  keywords       Json?
  locale         String   @default("fa")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity       BusinessEntity @relation(fields: [entityId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, entityId, locale])
  @@index([organizationId, schemaType])
  @@index([organizationId, locale])
