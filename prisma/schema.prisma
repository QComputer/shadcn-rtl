  targetAudience     Json                        @default("[]")
  preferredKeywords  Json                        @default("[]")
  preferredLocations Json                        @default("[]")
  notes              String?                     @db.Text
  metadata           Json?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  keywordClusters KeywordCluster[]
  recommendations GrowthRecommendation[]

  @@index([status, updatedAt])
}

model KeywordCluster {
  id              String                 @id @default(cuid())
  publicId        String                 @unique @default(uuid())
  organizationId  String
  profileId       String?
  relatedEntityId String?
  keyword         String
  intent          KeywordIntent
  priority        SeoOpportunityPriority @default(MEDIUM)
  source          KeywordClusterSource
  status          KeywordClusterStatus   @default(PROPOSED)
  metadata        Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        BusinessGrowthProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
